#!/usr/bin/env bash
set -euo pipefail

step() {
	printf '\n==> %s\n' "$1"
}

step 'Check Node.js version'
node --eval '
const [major, minor] = process.versions.node.split(".").map(Number)
if (major < 24 || (major === 24 && minor < 11)) {
  console.error(`Node.js ${process.versions.node} is too old; this repo requires 24.11 or newer.`)
  process.exit(1)
}
console.log(`Node.js ${process.versions.node}`)
'

step 'Ensure pnpm 12.0.0'
current_pnpm="$(pnpm --version 2>/dev/null || true)"
if [[ "$current_pnpm" != '12.0.0' ]]; then
  npm install --global pnpm@12.0.0
fi
pnpm --version

step 'Install workspace dependencies'
pnpm install --frozen-lockfile

step 'Install Rust for the Solver and the content compiler'
if ! command -v rustup >/dev/null && [[ ! -x "$HOME/.cargo/bin/rustup" ]]; then
  curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain none
fi
export PATH="$HOME/.cargo/bin:$PATH"
# rust-toolchain.toml pins the channel and the wasm target.
(cd packages/simulation/solver && rustup toolchain install)
rustup default "$(cd packages/simulation/solver && rustup show active-toolchain | cut -d' ' -f1)"
if ! grep -Fq '.cargo/env' "$HOME/.bashrc" 2>/dev/null; then
  echo '. "$HOME/.cargo/env"' >> "$HOME/.bashrc"
fi
rustc --version

step 'Install Playwright browsers for pnpm test:engines'
(cd packages/simulation && pnpm exec playwright install chromium firefox webkit)
if sudo -n true 2>/dev/null; then
  (cd packages/simulation && sudo -n env "PATH=$PATH" pnpm exec playwright install-deps webkit)
fi

step 'Install mise, Java and TLC for the formal verification skills'
export PATH="$HOME/.local/bin:$PATH"
if ! command -v mise >/dev/null; then
  curl -fsSL https://mise.run | sh
fi
tla_tool="$(sed -n '/^  "http:tla2tools/{s/^  "//;s/";$//;p}' .agents/skills/statechart/scripts/run.ts)"
(cd "$(mktemp -d)" && MISE_CEILING_PATHS="$PWD" mise install java@temurin-25 "$tla_tool")
if ! grep -Fq '.local/bin' "$HOME/.bashrc" 2>/dev/null; then
  echo 'export PATH="$HOME/.local/bin:$PATH"' >> "$HOME/.bashrc"
fi

step 'Install Pele to render statecharts'
if [[ ! -d "$HOME/.cache/pele/node_modules/pele" ]]; then
  mkdir -p "$HOME/.cache/pele"
  (cd "$HOME/.cache/pele" && npm install --no-save --no-audit --no-fund pele@1.9.0)
fi
