/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(self), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  # The dictation recognizer's wasm is threaded: SharedArrayBuffer needs isolation.
  Cross-Origin-Embedder-Policy: credentialless
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://ampcode.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://ampcode.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://ampcode.com; connect-src 'self' https://*.ingest.sentry.io https://*.sentry.io https://ampcode.com wss://playquorum.dev; worker-src 'self' blob:; media-src 'self' blob:; manifest-src 'self'; frame-src https://ampcode.com; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; form-action 'self'; upgrade-insecure-requests
  Cache-Control: public, max-age=0, must-revalidate
  Document-Policy: js-profiling

/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/og.png
  ! Cache-Control
  Cache-Control: public, max-age=86400

/icon-192.png
  ! Cache-Control
  Cache-Control: public, max-age=86400

/icon-512.png
  ! Cache-Control
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  ! Cache-Control
  Cache-Control: public, max-age=86400

/favicon.svg
  ! Cache-Control
  Cache-Control: public, max-age=86400

/manifest.webmanifest
  ! Cache-Control
  Cache-Control: public, max-age=86400
