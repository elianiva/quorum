{
  "name": "@quorum/wiki",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/measure.ts --if-stale && vite build --config vite.site.config.ts && node scripts/site-artifacts.ts",
    "measurements": "node scripts/measure.ts",
    "changelog:render": "node scripts/changelog.ts render",
    "changelog:write": "node scripts/changelog.ts write",
    "typecheck": "tsrs --noEmit -p tsconfig.json && effect-tsrs diagnostics --strict --project tsconfig.json --lspconfig '{\"allowedExperimentalApis\":[\"@effect/ui\"]}'",
    "test": "vitest run",
    "dev": "vite --config vite.site.config.ts"
  },
  "dependencies": {
    "@effect/ui": "https://pkg.pr.new/Effect-TS/ui/@effect/ui@1015b18",
    "@quorum/simulation": "workspace:*",
    "@quorum/styled-system": "workspace:*",
    "@quorum/ui": "workspace:*",
    "effect": "4.1.4",
    "js.foresight": "^4.2.1",
    "katex": "0.19.1",
    "lucide": "1.73.0",
    "minisearch": "7.2.0",
    "pele": "1.13.0",
    "posthog-js": "1.450.0",
    "simple-icons": "16.38.0",
    "takumi-js": "^2.20.0",
    "vite": "8.3.8"
  },
  "devDependencies": {
    "@pandacss/preset-base": "catalog:",
    "@pandacss/preset-panda": "catalog:",
    "@pandacss/vite": "catalog:",
    "@types/node": "26.6.6",
    "vitest": "5.1.0"
  }
}
