{
  "name": "quorum",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "prepare": "panda codegen && lefthook install && effect-tsrs patch --oxlint",
    "codegen": "panda codegen",
    "dev": "alchemy dev",
    "dev:reference": "alchemy dev --stage reference",
    "build": "turbo run build",
    "check": "vp check",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "lint": "vp lint",
    "typecheck": "tsrs --noEmit -p tsconfig.json && effect-tsrs diagnostics --strict --project tsconfig.json && turbo run typecheck",
    "test": "turbo run test",
    "test:full": "FULL_TESTS=1 turbo run test",
    "test:engines": "pnpm --filter @quorum/simulation test:engines",
    "measurements": "node apps/wiki/scripts/measure.ts",
    "deploy": "alchemy deploy --stage prod"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@alchemy.run/domain": "2.0.0-beta.85",
    "@alchemy.run/frontend-frameworks": "2.0.0-beta.85",
    "@cloudflare/workers-types": "5.20261106.1",
    "@effect/language-service": "0.87.5",
    "@pandacss/dev": "catalog:",
    "@pandacss/preset-base": "catalog:",
    "@pandacss/preset-panda": "catalog:",
    "@quorum/rpc": "workspace:*",
    "@sentry/rollup-plugin": "11.11.0",
    "@types/node": "26.6.6",
    "@yielded/effect-tsrs": "0.2.3",
    "alchemy": "2.0.0-beta.85",
    "effect": "4.1.2",
    "lefthook": "2.2.2",
    "tsrs": "0.22.0-ts7.1.0-beta",
    "turbo": "2.11.10",
    "vite-plus": "1.4.0",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@12.0.0"
}
