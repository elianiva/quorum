(id AchievementId achievement-ids)

(def achievement-ids
  :type const
  ["hello-world" "works-on-my-machine" "split-brain" "averages-lie" "shared-nothing" "blocked"
   "off-by-one-region" "littles-law" "metastable" "big-rewrite" "strangler" "quorum" "eventually"
   "polyglot" "zero-gc" "no-cache" "celebrity" "follow-the-sun" "postgres-for-everything"
   "hug-of-death" "egress-shock" "chaos-monkey" "blameless" "nines" "five-nines" "monoglot"
   "default-alive" "unicorn" "decacorn" "everyone-online" "warm-start" "rule-of-40" "beat-and-raise"
   "serial-founder" "two-hard-things" "conways-law" "fallacies" "thundering-herd" "runbook" "finops"
   "spot-the-difference" "let-it-crash"])

(table achievements
  :key      id
  :keep-key
  :type     (record AchievementId AchievementDef)
  [id                         name                       condition]
  ["hello-world"              "Hello, World"             "Serve the first request"]
  ["works-on-my-machine"      "It Works on My Machine"   "Ship a bad deploy"]
  ["split-brain"              "Split Brain"              "Split the database onto its own Node"]
  ["averages-lie"             "Averages Lie"             "Research percentiles while p99 is more than 5× the mean"]
  ["shared-nothing"           "Shared Nothing"           "Reach Seed with only PHP-FPM servers and no memory incident"]
  ["blocked"                  "Blocked"                  "Have a Node.js service whose p99 rises by 100 ms from one kind"]
  ["off-by-one-region"        "Off by One Region"        "Serve a user from a region more than 150 ms away"]
  ["littles-law"              "Little's Law"             "Fix an app server bottleneck by fixing the database"]
  ["metastable"               "Metastable"               "Recover from a retry storm"]
  ["big-rewrite"              "Big Rewrite"              "Migrate every service to a new language in one company"]
  ["strangler"                "Strangler"                "Finish a migration in four traffic steps with errors under 1%"]
  ["quorum"                   "Quorum"                   "Run a wide-column store with R + W > N across three regions"]
  ["eventually"               "Eventually"               "Run R = 1, W = 1 at a billion users"]
  ["polyglot"                 "Polyglot"                 "Run five languages in production at once"]
  ["zero-gc"                  "Zero GC"                  "Run a Rust service at 100,000 rps"]
  ["no-cache"                 "No Cache"                 "Reach Series A with no Cache and no CDN"]
  ["celebrity"                "Celebrity"                "Serve a 10-million-follower post with no hot key errors"]
  ["follow-the-sun"           "Follow the Sun"           "Serve four regions with no Node above 70% at its local peak"]
  ["postgres-for-everything"  "Postgres for Everything"  "Reach Series B with only Postgres data Components"]
  ["hug-of-death"             "Hug of Death"             "Survive a ×10 spike with no lost users"]
  ["egress-shock"             "Egress Shock"             "Have egress be the largest line on the bill"]
  ["chaos-monkey"             "Chaos Monkey"             "Survive 100 random terminations"]
  ["blameless"                "Blameless"                "Write 50 postmortems"]
  ["nines"                    "Nines"                    "Hold 99.99% for a calendar week"]
  ["five-nines"               "Five Nines"               "Complete the Five Nines Challenge"]
  ["monoglot"                 "Monoglot"                 "Reach IPO with one language"]
  ["default-alive"            "Default Alive"            "Reach IPO without raising any round"]
  ["unicorn"                  "Unicorn"                  "Reach a $1 billion valuation"]
  ["decacorn"                 "Decacorn"                 "Reach a $10 billion valuation"]
  ["everyone-online"          "Everyone Online"          "Reach 6 billion users"]
  ["warm-start"               "Warm Start"               "Scale a JVM service during a spike with no p99 regression"]
  ["rule-of-40"               "Rule of 40"               "Reach a Rule of 40 score of 80 as a public company"]
  ["beat-and-raise"           "Beat and Raise"           "Beat guidance eight quarters in a row"]
  ["serial-founder"           "Serial Founder"           "Exit with every Venture"]
  ["two-hard-things"          "Two Hard Things"          "Have a stale-read incident on a cache"]
  ["conways-law"              "Conway's Law"             "Have more Services than teams, then fix it"]
  ["fallacies"                "Fallacies"                "Experience all eight fallacies of distributed computing in incidents"]
  ["thundering-herd"          "Thundering Herd"          "Survive a reconnect storm with no errors"]
  ["runbook"                  "Runbook"                  "Have an incident resolve with no player action"]
  ["finops"                   "FinOps"                   "Run a fleet with reserved, on-demand, and spot Nodes at once"]
  ["spot-the-difference"      "Spot the Difference"      "Survive a spot reclaim with no errors"]
  ["let-it-crash"             "Let It Crash"             "Have an Elixir service survive 1,000 crashes with no failed requests"])
