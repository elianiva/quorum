(types "../catalog/kinds.ts" Kind)

(def CDN_HIT :type "Partial<Record<Kind, number>>" (:page 0.7 :media 0.75))
(def ANONYMOUS_PAGE 0.6)
(def TIERED_MEDIA_HIT 0.92)
(def CDN_TTLS :type const [(:ttl 60 :factor 0.8) (:ttl 300 :factor 1) (:ttl 3_600 :factor 1.2)])
(def ESI_PAGE_HIT 0.2)

(def STALE_AFTER_DEPLOY 0.3)

(def CACHE_KEYS :type const
  (:full (:name "Path, query and cookies" :hit 1 :leak 0)
   :query (:name "Path and query" :hit 1.1 :leak 1)
   :path (:name "Path only" :hit 1.2 :leak 2.5)))

(def cdnGlossary :type "ReadonlyArray<string>"
  ["cache-hit-rate" "cdn-content-delivery-network" "egress"])
