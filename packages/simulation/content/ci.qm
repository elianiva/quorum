(types "../components/ci.ts" DeployStrategyId DeployStrategyDef)

(def ROLLOUT_SHARE 0.25)

(def DEPLOY_STRATEGY_IDS :type const ["recreate" "rolling" "blue-green" "canary"])

(def DEPLOY_STRATEGIES :type "Record<DeployStrategyId, DeployStrategyDef>"
  (:recreate (:id "recreate" :name "Recreate" :deployMinutes 2 :blast 1 :burn 1)
   :rolling (:id "rolling" :name "Rolling" :deployMinutes 5 :blast 0.4 :burn 1)
   :blue-green (:id "blue-green" :name "Blue-green" :deployMinutes 7 :blast 0.1 :burn 2)
   :canary (:id "canary" :name "Canary" :deployMinutes 10 :blast 0.05 :burn 1.5)))

(def STRATEGY_RESEARCH :type "Partial<Record<DeployStrategyId, ResearchId>>"
  (:blue-green "blue-green" :canary "canary"))
