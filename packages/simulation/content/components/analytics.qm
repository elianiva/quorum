; Analytics: the Component and the tables it reads.
(component analytics
  :code     otel
  :name     "Analytics"
  :product  "OpenTelemetry"
  :group    ops
  :dock     insight
  :cost     40
  :latency  0ms
  :burn     0.05
  :steps    8
  :max-out  0
  :flags    (tap global)
  :blurb    "Link any Node into it. It samples that traffic and turns it into Insight."
  :glossary (observability))

(state analytics
  (field sample-rate number
    :default 0.1)
  (field retention number
    :default 900))

(constants sample
  (rates :type const [0.01 0.05 0.1 0.5 1])
  (overhead :type const [0.002 0.01 0.02 0.08 0.15])
  (latency :type const [0 0.5 1 3 5])
  (storage :type const [0.1 0.5 1 5 10]))

(constants retention
  (windows :type const [900 3_600 21_600])
  (storage :type const [1 2 4]))

(def analytics-capacity 4)
