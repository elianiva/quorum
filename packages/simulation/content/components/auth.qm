; Auth: the Component and the tables it reads.
(component auth
  :code     idp
  :name     "Auth Provider"
  :product  "Auth0"
  :group    data
  :dock     managed
  :cost     0
  :latency  120ms
  :max-out  0
  :unlock   auth-provider
  :flags    (global)
  :accepts  (auth)
  :inbound  (edge fn server)
  :outbound ()
  :blurb    "Hashes passwords for you. Charged per user."
  :glossary (bcrypt))

(def auth-price-per-user 0.00006)
