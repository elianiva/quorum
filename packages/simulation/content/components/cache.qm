; Cache: the Component and the tables it reads.
(component cache
  :code     kv
  :name     "Cache"
  :product  "Redis"
  :group    data
  :dock     data
  :cost     150
  :latency  0.5ms
  :burn     0.06
  :steps    8
  :unlock   caching
  :capacity 50_000
  :flags    (limiting cold-start standby)
  :accepts  (q-read q-write q-search blob-put q-tx blob-get q-scan k-write change)
  :sends    (q-read q-write q-search blob-put q-tx blob-get q-scan k-write)
  :fallback (q-search blob-put blob-get q-scan q-tx k-write)
  :blurb    "The cheapest way to cut reads while the hot data fits in memory. Writes pass through and invalidate, and a restart starts cold.")

(state cache
  (field early-expiry bool
    :default false)
  (field swr bool
    :default false)
  (field engine (enum redis memcached)
    :default redis
    :schema  CacheEngine)
  (field cache-strategy (enum aside read-through write-through write-behind)
    :default aside
    :schema  CacheStrategy
    :gate    (cache-strategies "Cache strategies"))
  (field coalesce bool
    :default false)
  (field warming bool
    :default false)
  (field split bool
    :default false))

(gate cache coalesce
  :research stampede-protection
  :what     "Coalescing"
  :locked   (true))

(gate cache earlyExpiry
  :research stampede-protection
  :what     "Early expiration"
  :locked   (true))

(gate cache swr
  :research stampede-protection
  :what     "Stale-while-revalidate"
  :locked   (true))

(gate cache warming
  :research cache-warming
  :what     "Warming"
  :locked   (true))

(table cache-engines
  :key id
  [id         name         growth  memory  speed  warmAfterRestart]
  [redis      "Redis"         1.7       1      1               0.5]
  [memcached  "Memcached"       2    1.12    1.2                 0])

(table cache-ttls
  [ttl    factor  stale]
  [   10     0.6  0.005]
  [   60    0.85   0.02]
  [3_600    0.97    0.1])

(def CACHE_OPS 100_000)

(def WRITE_BEHIND_SECONDS 10)

(table cache-strategies
  :key id
  [id             name             stale  write      writeMs  flush  loadMs]
  [aside          "Cache-aside"        1  "bypass"         0      1       0]
  [read-through   "Read-through"    0.75  "bypass"         0      1       1]
  [write-through  "Write-through"      0  "through"      0.5      1       0]
  [write-behind   "Write-behind"     0.5  "ahead"          0    0.5       0])

(def COALESCED 0.25)

(def WARMED 0.8)

(constants early
  (lift 0.5)
  (refresh 0.02))

(def cacheGlossary
  :type (array string)
  ["cache-hit-rate" "cache-aside" "hot-key" "write-through-cache"])
