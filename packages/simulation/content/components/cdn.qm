; Cdn: the Component and the tables it reads.
(component cdn
  :code     cdn
  :name     "CDN"
  :product  "Cloudflare"
  :group    edge
  :dock     edge
  :cost     220
  :latency  8ms
  :burn     0.05
  :unlock   cdn
  :flags    (global tls)
  :accepts  (requests)
  :sends    (requests)
  :inbound  (dns gw users waf)
  :outbound (edge fn gw lb server storage waf)
  :blurb    "Answers cacheable pages near the user. Egress from the edge costs less."
  :glossary (cache-hit-rate cdn-content-delivery-network egress))

(state cdn
  (field purge bool
    :default false)
  (field cache-key (key-of cache-keys)
    :default full
    :schema  CacheKey)
  (field stale-until number
    :default 0))

(def cdn-hit
  :type (partial (record Kind number))
  (:page  0.7
   :media 0.75))

(def anonymous-page 0.6)

(def tiered-media-hit 0.92)

(table cdn-ttls
  [ttl    factor]
  [   60     0.8]
  [  300       1]
  [3_600     1.2])

(def esi-page-hit 0.2)

(table cache-keys
  :key         id
  :export-rust
  :ids         cache-key-ids
  [id     name                       hit  leak]
  [full   "Path, query and cookies"    1     0]
  [query  "Path and query"           1.1     1]
  [path   "Path only"                1.2   2.5])

(def stale-after-deploy 0.3)
