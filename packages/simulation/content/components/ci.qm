; Ci: the Component and the tables it reads.
(component ci
  :code     ci
  :name     "CI/CD Pipeline"
  :product  "GitHub Actions"
  :group    ops
  :dock     platform
  :cost     100
  :latency  1ms
  :burn     0.02
  :max-out  0
  :unlock   ci
  :inbound  ()
  :outbound ()
  :blurb    "Ships what waits. Its deploy strategy sets how long a deploy takes, what it burns, and how bad a bad deploy is.")

(state ci
  (field strategy (key-of deploy-strategies)
    :default rolling
    :schema  DeployStrategy))

(table deploy-strategies
  :key      id
  :ids      deploy-strategy-ids
  :id-type  DeployStrategyId
  :keep-key
  :type     (record DeployStrategyId DeployStrategyDef)
  [id          name          deployMinutes  blast  burn]
  [recreate    "Recreate"                2      1     1]
  [rolling     "Rolling"                 5    0.4     1]
  [blue-green  "Blue-green"              7    0.1     2]
  [canary      "Canary"                 10   0.05   1.5])

(def strategy-research
  :type (partial (record DeployStrategyId ResearchId))
  (:blue-green "blue-green"
   :canary     "canary"))

(def rollout-share 0.25)
