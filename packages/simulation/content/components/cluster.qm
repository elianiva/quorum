; Cluster: the Component and the tables it reads.
(component cluster
  :code    k8s
  :name    "Kubernetes Cluster"
  :product "Kubernetes"
  :group   compute
  :dock    compute
  :cost    500
  :latency 0ms
  :burn    0.1
  :max-out 0
  :unlock  containers
  :flags   (control)
  :blurb   "Link App Servers or Workers into it. They pack onto shared nodes: 15% less Burn, copies in 30 s.")

(state cluster
  (field upgraded-at number
    :default 0))

(constants noisy
  (share 0.01)
  (ms 10))

(def UPGRADE_CRASHES 0.3)

(def SUPPORTED_QUARTERS 1)

(def PLATFORM_TAX 0.5)

(def clusterGlossary
  :type (array string)
  ["cold-start" "container-orchestration"])
