; Dns: the Component and the tables it reads.
(component dns
  :code     dns
  :name     "DNS"
  :product  "Route 53"
  :group    edge
  :dock     edge
  :cost     20
  :latency  0ms
  :burn     0.01
  :max-out  8
  :unlock   dns-rr
  :accepts  (requests)
  :sends    (requests)
  :blurb    "Round robin across up to 8 hosts. No health checks: a dead host keeps its share."
  :glossary (dns-round-robin health-check vertical-and-horizontal-scaling))

(def dns-ttls
  :type const
  [30 300 3_600])
