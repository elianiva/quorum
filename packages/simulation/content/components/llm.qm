; Llm: the Component and the tables it reads.
(component llm
  :code     llm
  :name     "LLM API"
  :product  "A hosted model"
  :group    data
  :dock     managed
  :cost     0
  :latency  600ms
  :steps    8
  :max-out  0
  :unlock   hosted-models
  :flags    (limiting global zone-spanning)
  :accepts  (infer)
  :inbound  (edge fn server)
  :outbound ()
  :blurb    "Serves AI prompts with no GPUs. Paid per token, and rate limited."
  :glossary (model-inference rate-limiting))

(constants llm
  (first-token-ms 600)
  (price 2.5)
  (rate 100))
