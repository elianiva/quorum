; Log: the Component and the tables it reads.
(component log
  :code     log
  :name     "Event Stream"
  :product  "Apache Kafka"
  :group    compute
  :dock     messaging
  :cost     900
  :latency  5ms
  :burn     0.3
  :steps    6
  :unlock   event-streaming
  :capacity 100_000
  :flags    (limiting)
  :accepts  (task change)
  :sends    (task change)
  :inbound  (cdc server)
  :outbound (cache queue search warehouse worker)
  :blurb    "A log, not a queue: events stay after they are read, so a consumer can replay them. Consumers read one partition each and fall behind at their own pace."
  :glossary (at-least-once-delivery cdc-change-data-capture))

(state log
  (field partitions number
    :default 3)
  (field acks (enum "0" "1" all)
    :default all
    :schema  Acks)
  (field retain number
    :default 3_600)
  (field keyed bool
    :default true))

(def log-rate 100_000)

(def log-read-rate 20_000)

(def log-partitions
  :type const
  [1 3 6 12])

(def log-acks
  :export-rust
  :type        const
  (record "0" (:name "No ack" :latency 0.4) "1" (:name "Leader" :latency 1)
    :all (:name "All replicas" :latency 1.5)))

(def log-retention
  :type const
  [600 3_600 10_080])

(def log-replica-burn 0.5)

(def log-replicas
  :type const
  [1 2 3])

(def log-loss
  :type const
  (record "0" 0.1 "1" 0.05
    :all 0))
