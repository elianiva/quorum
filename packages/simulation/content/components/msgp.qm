; Msgp: the Component and the tables it reads.
(component msgp
  :code     msgp
  :name     "Push Provider"
  :product  "FCM, APNs, SES"
  :group    data
  :dock     managed
  :cost     0
  :latency  100ms
  :max-out  0
  :unlock   notifications
  :flags    (limiting global)
  :accepts  (notify)
  :inbound  (edge fn server worker)
  :outbound ()
  :blurb    "Sends push notifications and email. Paid per message, 10,000 a second.")

(constants msgp
  (rate 10_000)
  (price 0.0001))
