; Psp: the Component and the tables it reads.
(component psp
  :code     psp
  :name     "Payment Provider"
  :product  "Stripe"
  :group    data
  :dock     managed
  :cost     0
  :latency  400ms
  :steps    8
  :max-out  0
  :unlock   checkout
  :flags    (limiting global zone-spanning)
  :accepts  (charge)
  :inbound  (edge fn server)
  :outbound ()
  :blurb    "Charges cards for checkouts. 2.9% plus $0.30 per checkout."
  :glossary (idempotency))

(state psp
  (field provider (enum first second)
    :default first
    :schema  Provider))

(constants psp
  (rate 0.029)
  (fixed 0.3))

(def second-provider-fee 1.15)

(def psp-capacity 1_000)
