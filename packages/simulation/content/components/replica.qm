; Replica: the Component and the tables it reads.
(component replica
  :code     rep
  :name     "Read Replica"
  :product  "PostgreSQL or MySQL replica"
  :group    data
  :dock     data
  :cost     60
  :latency  2ms
  :max-out  0
  :unlock   replication
  :flags    (sized limiting cold-start)
  :accepts  (q-read q-scan)
  :inbound  (cache database edge fn lb pooler server worker)
  :outbound ()
  :blurb    "Link a Database into it, and it copies that Database. Takes reads and reports off it, and adding one does not restart it. Lags behind writes, so some API reads come back stale."
  :glossary (eventual-consistency read-replica read-your-writes-consistency replication-lag))

(state replica
  (field sync bool
    :default false
    :gate    (sync-replication "Synchronous replication" :locked (true))))

(constants replica
  (sync-minutes-per-gb 0.5)
  (box-price 0.7))

(def promote-data-loss 0.02)

(def sync-ms 2)
