; Replica: the Component and the tables it reads.
(component replica
  :code    rep
  :name    "Read Replica"
  :product "PostgreSQL or MySQL replica"
  :group   data
  :dock    data
  :cost    60
  :latency 2ms
  :max-out 0
  :unlock  replication
  :flags   (sized limiting cold-start)
  :accepts (q-read q-scan)
  :blurb   "Link a Database into it, and it copies that Database. Takes reads and reports off it, and adding one does not restart it. Lags behind writes, so some API reads come back stale.")

(state replica
  (field sync bool
    :default false))

(gate replica sync
  :research sync-replication
  :what     "Synchronous replication"
  :locked   (true))

(constants replica
  (sync-minutes-per-gb 0.5)
  (box-price 0.7))

(def PROMOTE_DATA_LOSS 0.02)

(def replicaGlossary
  :type (array string)
  ["eventual-consistency" "read-replica" "read-your-writes-consistency" "replication-lag"])
