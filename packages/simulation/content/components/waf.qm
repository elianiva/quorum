; Waf: the Component and the tables it reads.
(component waf
  :code     waf
  :name     "WAF"
  :product  "ModSecurity"
  :group    edge
  :dock     edge
  :cost     260
  :latency  2ms
  :burn     0.1
  :steps    6
  :unlock   waf
  :capacity 5_000
  :flags    (limiting zone-spanning tls)
  :accepts  (requests)
  :sends    (requests)
  :blurb    "Blocks bots before they reach the app, and some real users with them.")

(state waf
  (field paranoia number
    :default 2)
  (field under-attack bool
    :default false))

(table paranoia
  [level  block  falsePositive  cpu]
  [    1    0.6          0.001    1]
  [    2    0.8          0.005  1.5]
  [    3   0.92           0.02  2.5]
  [    4   0.98           0.06    4])

(def under-attack
  :type const
  (:block         0.99
   :falsePositive 0.01
   :latency       40
   :cpu           1))

(def wafGlossary
  :type (array string)
  ["rate-limiting" "waf-web-application-firewall"])
