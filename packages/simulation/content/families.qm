; Families whose constants belong to different modules.
; Each entry keeps its value and names the module that exports it.
; A type in an entry is declared by that module's content file.
(constants auth
  (check-ms :module components 0.02)
  (price-per-user :module auth 0.00006)
  (move-dh :module team 120))

(constants bot
  (management-false :module waf 0.5)
  (surge :module incidents 0.8))

(constants calendar
  (start :module eras (* 14 60))
  (duration
    :module incidents
    :type   (readonly (record (union 1 2 3) number))
    (record "1" 60 "2" 20 "3" 5))
  (day :module team 1_440)
  (pace :module tuning 24))

(constants cdc
  (lag-stale :module components 0.0002)
  (drop-stale :module components 0.005)
  (rate :module cdc 20_000)
  (changes :module cdc :type const ["q-write" "q-tx" "k-write"])
  (ms :module cdc 2))

