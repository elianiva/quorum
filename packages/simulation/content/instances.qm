(table sizes
  [name       vcpu  gbps]
  ["nano"      0.5   0.5]
  ["micro"       1     1]
  ["small"       2     2]
  ["medium"      4     5]
  ["large"       8    10]
  ["xlarge"     16  12.5]
  ["2xlarge"    32    25]
  ["4xlarge"    64    50]
  ["metal"      96   100])

(table families
  :key      id
  :ids      family-ids
  :id-type  FamilyId
  :keep-key
  :type     (record FamilyId FamilyDef)
  [id         name         ramPerVcpu  price  blurb]
  [burstable  "Burstable"           2    0.4  "Cheap. Earns CPU credits while idle and drops to 20% CPU when they run out."]
  [general    "General"             4      1  "1 vCPU : 4 GB."]
  [compute    "Compute"             2   0.85  "1 vCPU : 2 GB."]
  [memory     "Memory"              8    1.3  "1 vCPU : 8 GB."]
  [arm        "ARM"                 4    0.8  "Same as General for 20% less. Some runtimes and libraries need work to port."])

(def arm-research
  :type const
  "arm-instances")

(def vcpu-price 0.05)

(def burst-baseline 0.2)

(def credit-cap 100)

(def os-ram 0.25)

(constants local
  (db-ram 0.6)
  (db-ram-per-user 0.0015)
  (db-contention 1.5))

(def max-connections 100)

(def pooler-connections 20)

(def restart-seconds 2)

(def oom-ratio 1.25)

(def warmup-seconds 15)

(def hop-ms 0.5)

(def handshake-ms 1)

(def link-timeout 30)

(def active-users-per-rps 50)

(constants shed
  (from 1)
  (to 0.95))

(constants io
  (per-write 6)
  (per-tx 12)
  (per-scan 40)
  (per-spilled-read 4))

(def worker-task-mb 20)

(def vm-restart-seconds 1)
