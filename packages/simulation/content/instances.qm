(types "../catalog/instances.ts" FamilyId FamilyDef)

(table sizes
  [name       vcpu  gbps]
  ["nano"      0.5   0.5]
  ["micro"       1     1]
  ["small"       2     2]
  ["medium"      4     5]
  ["large"       8    10]
  ["xlarge"     16  12.5]
  ["2xlarge"    32    25]
  ["4xlarge"    64    50]
  ["metal"      96   100])

(def FAMILY_IDS
  :type const
  ["burstable" "general" "compute" "memory" "arm"])

(table families
  :key      id
  :keep-key
  :type     (record FamilyId FamilyDef)
  [id           name         ramPerVcpu  price  blurb]
  ["burstable"  "Burstable"           2    0.4  "Cheap. Earns CPU credits while idle and drops to 20% CPU when they run out."]
  ["general"    "General"             4      1  "1 vCPU : 4 GB."]
  ["compute"    "Compute"             2   0.85  "1 vCPU : 2 GB."]
  ["memory"     "Memory"              8    1.3  "1 vCPU : 8 GB."]
  ["arm"        "ARM"                 4    0.8  "Same as General for 20% less. Some runtimes and libraries need work to port."])

(def ARM_RESEARCH
  :type const
  "arm-instances")

(def VCPU_PRICE 0.05)

(def BURST_BASELINE 0.2)

(def CREDIT_CAP 100)

(def OS_RAM 0.25)

(constants local
  (db-ram 0.6)
  (db-ram-per-user 0.0015)
  (db-contention 1.5))

(def max-connections 100)

(def POOLER_CONNECTIONS 20)

(def RESTART_SECONDS 2)

(def OOM_RATIO 1.25)

(def WARMUP_SECONDS 15)

(def HOP_MS 0.5)

(def HANDSHAKE_MS 1)

(def LINK_TIMEOUT 30)

(def ACTIVE_USERS_PER_RPS 50)

(constants shed
  (from 1)
  (to 0.95))

(constants io
  (per-write 6)
  (per-tx 12)
  (per-scan 40)
  (per-spilled-read 4))
