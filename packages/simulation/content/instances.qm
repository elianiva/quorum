(types "../catalog/instances.ts" FamilyId FamilyDef)

(def SIZES :type const
  [(:name "nano" :vcpu 0.5 :gbps 0.5)
   (:name "micro" :vcpu 1 :gbps 1)
   (:name "small" :vcpu 2 :gbps 2)
   (:name "medium" :vcpu 4 :gbps 5)
   (:name "large" :vcpu 8 :gbps 10)
   (:name "xlarge" :vcpu 16 :gbps 12.5)
   (:name "2xlarge" :vcpu 32 :gbps 25)
   (:name "4xlarge" :vcpu 64 :gbps 50)
   (:name "metal" :vcpu 96 :gbps 100)])

(def FAMILY_IDS :type const ["burstable" "general" "compute" "memory" "arm"])

(def FAMILIES :type "Record<FamilyId, FamilyDef>"
  (:burstable (:id "burstable"
               :name "Burstable"
               :ramPerVcpu 2
               :price 0.4
               :blurb "Cheap. Earns CPU credits while idle and drops to 20% CPU when they run out.")
   :general (:id "general" :name "General" :ramPerVcpu 4 :price 1 :blurb "1 vCPU : 4 GB.")
   :compute (:id "compute" :name "Compute" :ramPerVcpu 2 :price 0.85 :blurb "1 vCPU : 2 GB.")
   :memory (:id "memory" :name "Memory" :ramPerVcpu 8 :price 1.3 :blurb "1 vCPU : 8 GB.")
   :arm (:id "arm"
         :name "ARM"
         :ramPerVcpu 4
         :price 0.8
         :blurb "Same as General for 20% less. Some runtimes and libraries need work to port.")))

(def ARM_RESEARCH :type const "arm-instances")

(def VCPU_PRICE 0.05)
(def BURST_BASELINE 0.2)
(def CREDIT_CAP 100)
(def OS_RAM 0.25)
(def LOCAL_DB_RAM 0.6)
(def LOCAL_DB_RAM_PER_USER 0.0015)
(def LOCAL_DB_CONTENTION 1.5)
(def MAX_CONNECTIONS 100)
(def POOLER_CONNECTIONS 20)
(def RESTART_SECONDS 2)
(def VM_RESTART_SECONDS 1)
(def OOM_RATIO 1.25)
(def WARMUP_SECONDS 15)
(def HOP_MS 0.5)
(def HANDSHAKE_MS 1)
(def LINK_TIMEOUT 30)
(def ACTIVE_USERS_PER_RPS 50)
(def SHED_FROM 1)
(def SHED_TO 0.95)
(def PREFETCH_TASK_MB 20)
(def IO_PER_WRITE 6)
(def IO_PER_TX 12)
(def IO_PER_SCAN 40)
(def IO_PER_SPILLED_READ 4)
