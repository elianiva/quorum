(table profiles
  :key  id
  :type (record RequestKind RequestProfile)
  [id      cpu  native  apdex  calls  asyncCalls  orm  payloadKB  asyncKB  stream  compressible  inKB  offload  scored  completion]
  [page      4  false     400  (:q-read 2 :q-write 0)  (record)  true  80  80  false  true  0  0  true  -]
  [read    1.5  false     200  (:q-read 1 :q-write 0)  (record)  true  4  4  false  true  0  0  true  -]
  [write     2  false     300  (:q-read 0 :q-write 1)  (record)  false  2  2  false  false  0  0  true  -]
  [login    80  true      800  (:q-read 1 :q-write 0)  (record)  false  1  1  false  false  0  0  true  -]
  [search    3  false     300  (:q-search 1)  (record)  false  8  8  false  true  0  0  true  -]
  [upload  120  true    1_500  (record)  (:blob-put 1 :q-write 1)  false  2  2  false  false  2_000  0.9  true  10_000]
  [bot       2  false     400  (:q-read 1)  (record)  false  4  4  false  true  0  0  false  -]
  [media     1  false   1_000  (:blob-get 1)  (record)  false  5_000  5_000  true  false  0  0  true  -]
  [rt      0.3  false     100  (record)  (record)  false  1  1  false  false  0  0  true  -]
  [buy       5  false   2_000  (:q-read 1 :q-tx 1 :charge 1)  (record)  false  2  2  false  false  0  0  true  -]
  [job     400  false   1_000  (record)  (:q-read 50)  false  10_000  2  false  false  0  0.95  true  60_000]
  [report   20  false   3_000  (:q-scan 1)  (record)  false  50  50  false  true  0  0  true  -]
  [ai        5  false   4_000  (:infer 1)  (record)  false  4  4  true  false  0  0  true  -]
  [feed      6  false     300  (:q-read 20)  (record)  false  30  30  false  true  0  0  true  -]
  [hook      2  false   1_000  (record)  (:callout 1)  false  2  2  false  false  0  0.9  true  -]
  [push    0.5  false   1_000  (record)  (:notify 1)  false  1  1  false  false  0  0.9  true  -]
  [bid     0.5  false     100  (:q-read 1)  (record)  false  1  1  false  false  0  0  true  -])

(def query-cpu
  :type QueryCosts
  (:q-read   8
   :q-write  25
   :q-search 80
   :blob-put 60
   :q-tx     40
   :blob-get 30
   :q-scan   100))

(def stream-kb 500)

(def rt-hold-seconds 300)

(constants gzip
  (ratio 0.3)
  (cpu 1.1))

(def login-delegated-cpu 2)

(constants callout
  (ms 800)
  (failure 0.02))

(def followers 20)

(constants hybrid
  (writes 0.5)
  (reads 2))
