   :callout (:label "Customer call" :value 0 :color 7180090)
   :k-write (:label "Timeline write" :value 0 :color 13214247)
   :change (:label "Change" :value 0 :color 9072461)))

(def INSIGHT_POOLS :type const [(... REQUEST_KINDS) "failure"])

