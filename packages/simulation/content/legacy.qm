(types "../catalog/legacy.ts" ExitId ExitDef)

(def EXIT_IDS
  :type const
  ["acqui-hire" "acquisition" "ipo" "step-down"])

(table exits
  :key      id
  :keep-key
  :type     (record ExitId ExitDef)
  [id             name           stage  cap         multiplier  continues]
  ["acqui-hire"   "Acqui-hire"       3  50_000_000         0.5  false]
  ["acquisition"  "Acquisition"      4  Infinity             1  false]
  ["ipo"          "IPO"              6  Infinity           1.5  true]
  ["step-down"    "Step down"        7  Infinity           1.5  false])

(constants streak
  (bonus 0.1)
  (bonus-cap 1))

(def PERK_IDS
  :type const
  ["angel-network" "alumni-network" "institutional-knowledge" "pattern-recognition"
   "founders-reputation" "better-terms" "night-shift" "time-dilation" "playbooks" "war-stories"
   "head-start" "autopilot"])

(constants autopilot
  (payroll 0.25)
  (hires 4)
  (load 0.7))

(def PLAYBOOK_SLOTS
  :type (array number)
  [1 2 5 10 25])

(def DILATION_SPEEDS
  :type (array (array number))
  [[] [20] [20 40]])
