(types "../catalog/levers.ts" LeverKind)

(types "../catalog/work.ts" FeatureId)

(types "../catalog/ventures.ts" VentureId)

(constants lever
  (kinds
    :type const
    ["login" "search" "upload" "media" "rt" "buy" "job" "report" "ai" "feed" "hook" "push"])
  (steps :type const [1 2 3 4])
  (dh :type const [24 80 240])
  (growth :type const [0.99 0.98 0.96])
  (refund 0.5))

(def LEVER_OWNER
  :type (readonly (record LeverKind FeatureId))
  (:login  "password-login"
   :search "search-filters"
   :upload "profile-photos"
   :media  "video"
   :rt     "chat"
   :buy    "checkout"
   :job    "data-export"
   :report "dashboards"
   :ai     "ai-assistant"
   :feed   "activity-feed"
   :hook   "webhooks"
   :push   "push-notifications"))

(table lever-caps
  :key  id
  :type LeverCaps
  [id          kind      step]
  [fintech     "buy"        1]
  [ai-startup  "ai"         1]
  [healthcare  "upload"     1]
  [government  "push"       1])
