(def LOG_RATE 100_000)
(def LOG_READ_RATE 20_000)
(def LOG_PARTITIONS :type const [1 3 6 12])

(def LOG_ACKS :type const
  (record
   "0" (:name "No ack" :latency 0.4)
   "1" (:name "Leader" :latency 1)
   :all (:name "All replicas" :latency 1.5)))
(def LOG_RETENTION :type const [600 3_600 10_080])
(def LOG_REPLICA_BURN 0.5)
(def LOG_REPLICAS :type const [1 2 3])
(def LOG_LOSS :type const (record "0" 0.1 "1" 0.05 :all 0))

(def logGlossary :type "ReadonlyArray<string>" ["at-least-once-delivery" "cdc-change-data-capture"])
