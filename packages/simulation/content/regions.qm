(id SyncModeId sync-modes)

(id DataPatternId data-patterns)

(constants regions
  (from-stage 5))

(def home-region
  :type RegionId
  "na")

(table region-info
  :key     id
  :ids     regions
  :id-type RegionId
  :type    (record RegionId RegionDef)
  [id    name             short   share  offset]
  [na    "North America"  "NA"      0.4       0]
  [eu    "Europe"         "EU"      0.3     360]
  [apac  "Asia-Pacific"   "APAC"    0.2     840]
  [sa    "South America"  "SA"      0.1     120])

(def rtt
  :type (readonly (record string number))
  (:na-eu   75
   :na-apac 200
   :na-sa   120
   :eu-apac 160
   :eu-sa   190
   :apac-sa 300))

(def anycast-ms 20)

(def http3-cut 0.2)

(def http2-cut 0.15)

(def abroad-seed 0.05)

(def border-mixing 0.1)

(table device-info
  :key     id
  :ids     devices
  :id-type DeviceId
  :type    DeviceInfoById
  [id       name       share  rttMs]
  [desktop  "Desktop"   0.45      0]
  [mobile   "Mobile"    0.45     60]
  [tablet   "Tablet"     0.1     30])

(def mirror-time-minutes 30)

(def stage-wait-minutes 60)

(constants iac
  (switch-minutes calendar-day))

(def refresh-time-minutes 0.5)

(table iac-tool-info
  :key     id
  :ids     iac-tools
  :id-type IacToolId
  :type    (record IacToolId IacToolDef)
  [id         name         language      refreshOnPlan  refresh           repair]
  [terraform  "Terraform"  "HCL"         true           null              false]
  [pulumi     "Pulumi"     "TypeScript"  false          "pulumi refresh"  false]
  [alchemy    "Alchemy"    "TypeScript"  false          "alchemy drift"   true])

(def data-patterns
  :type const
  ["replica" "primary" "replicate" "call"])

(def egress-cross-region 0.02)

(def no-device-latency
  :type (record DeviceId number)
  (:desktop 0
   :mobile  0
   :tablet  0))

(def open-region-price 20_000)

(def sync-poll-minutes 3)

(def sync-modes
  :type const
  ["all" "staged"])

(def user-round-trips 2)
