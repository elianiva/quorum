(def team-tracks
  :type (record ResearchTeamKind (array ResearchTrack))
  (:product  ["product" "runtimes" "frameworks"]
   :platform ["infrastructure" "performance" "cost"]
   :sre      ["reliability" "observability"]
   :data     ["data"]
   :security ["security"]))

(def researchList research-list)

(def every-kind
  :type (array InsightPool)
  ["page" "read" "write" "login" "search" "upload" "media" "rt" "buy" "job" "report" "ai" "feed"
   "hook" "push"])

(def era-recipes
  :type (array (array InsightPool))
  [["page" "read"] ["write" "login"] ["search" "upload"] ["search" "upload"] ["media" "rt" "buy"]
   ["job" "report" "ai"] every-kind every-kind])

(def study-seconds
  :type const
  [20 60 120 240 480 900 1_800 3_600])

(constants study
  (speedup 0.25)
  (speed-research :type (array ResearchId) ["trace-search" "notebooks"]))

(def framework-research
  :type (record FrameworkId (union ResearchId null))
  (:none
    null
    (... framework-unlocks)))

(def max-studies 8)

(def spike-speed 2)

(research service-carve-out
  :name  "Carve out a Service"
  :track product
  :cost  600
  :era   seed
  :blurb "Move one capability to a new Service with its own Stack, deploys, and blast radius.")
