; Research: what the player studies, what each study needs, and what it unlocks.
;
; Each entry becomes one ResearchDef. Declaration order is the order of RESEARCH_IDS, which the
; Solver indexes by, so append new research at the end of its era's group.
(tracks
  (infrastructure "Infrastructure")
  (data "Data")
  (reliability "Reliability")
  (observability "Observability")
  (performance "Performance")
  (runtimes "Runtimes")
  (frameworks "Frameworks")
  (security "Security")
  (product "Product")
  (cost "Cost"))

; What a Study watches for, and the field each shape is measured by.
(study-shapes
  (connections
    :more-than count)
  (read-share
    :share share)
  (cache-hit
    :ratio share)
  (backlog
    :seconds seconds)
  (report-share
    :share share)
  (saturation
    :ratio share)
  (replica))

; A framework's research shares the framework's name and blurb, and unlocks it.
(defmacro framework (id name &key cost era (requires ()))
  `(research ,(sym "fw-" id)
     :name     ,name
     :track    frameworks
     :cost     ,cost
     :era      ,era
     :requires ,requires
     :blurb    (ref frameworks ,id blurb)
     :unlocks  (framework ,id)))

(research stripe
  :name  "Stripe Billing"
  :track product
  :cost  30
  :era   garage
  :blurb "Payments collect themselves.")

(research dns-rr
  :name  "DNS round robin"
  :track infrastructure
  :cost  15
  :era   garage
  :blurb "Unlocks DNS: spread Users over up to 8 hosts.")

(research load-balancing
  :name  "Load balancing"
  :track infrastructure
  :cost  25
  :era   garage
  :blurb "Unlocks the Load Balancer: split by capacity, skip dead hosts.")

(research custom-instances
