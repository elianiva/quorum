(research cdc
  :name     "Change data capture"
  :track    data
  :cost     18_000
  :era      series-b
  :requires (event-streaming data-warehouse)
  :insight  (report write)
  :blurb    "Unlocks the CDC Connector: the copies follow the write log, without a second write.")

(research service-boundaries
  :name     "Service boundaries"
  :track    product
  :cost     15_000
  :era      series-b
  :requires (service-carve-out)
  :blurb    "Give a Service its own team, so each team stays small and coordinates less.")

(research service-mesh
  :name     "Service mesh"
  :track    infrastructure
  :cost     20_000
  :era      series-b
  :requires (containers)
  :blurb    "Unlocks the Service Mesh: retries, breakers and metrics on every link.")

(research feature-flags
  :name     "Feature flags"
  :track    reliability
  :cost     800
  :era      seed
  :requires (ci)
  :blurb    "Unlocks Feature Flags: a Feature reaches a share of users, and a bad deploy with it.")

(research secrets-management
  :name  "Secrets management"
  :track security
  :cost  400
  :era   seed
  :blurb "Keys live in a vault, so a phishing page has nothing to steal.")

(research spam-filter
  :name  "Spam filter"
  :track security
  :cost  300
  :era   pre-seed
  :blurb "Adds a Postbox filter that sorts spam into its own folder, and now and then a real letter too.")

(research on-call
  :name     "On-call rotation"
  :track    reliability
  :cost     2_000
  :era      series-a
  :requires (alerting)
  :blurb    "A rotation answers the page, so an incident is acknowledged in minutes.")

(research runbooks
  :name     "Runbooks"
  :track    reliability
  :cost     5_000
  :era      series-a
  :requires (on-call)
  :blurb    "Write a runbook for an incident kind the team has handled: it then resolves itself.")

(research sre-team
  :name     "SRE team"
  :track    product
  :cost     4_000
  :era      series-a
  :requires (on-call)
  :blurb    "Unlocks the SRE team: MTTR −40%, and an open action item weighs half as much.")

(research enterprise-sales
  :name  "Enterprise sales"
  :track product
  :cost  20_000
  :era   series-b
  :blurb "Signs the SLA: a missed week of availability pays credits back to customers.")

(research online-migrations
  :name     "Online schema migrations"
  :track    data
  :cost     4_000
  :era      series-a
  :requires (query-analysis)
  :insight  (write)
  :blurb    "Changes a big table without holding its lock, so writes keep flowing through a migration.")

(research leap-smearing
  :name  "Leap smearing"
  :track reliability
  :cost  60_000
  :era   series-c
  :blurb "Spreads a leap second over the whole day, so no clock jumps and no lease expires early.")

(research ab-testing
  :name     "A/B testing"
  :track    product
  :cost     700
  :era      seed
  :requires (funnels feature-flags)
  :blurb    "Measures a Feature’s lift against the users its flag holds out, with a confidence interval.")

(research hiring-pipeline
  :name  "Hiring pipeline"
  :track product
  :cost  600
  :era   seed
  :blurb "Recruiters keep a pipeline warm, so every hire takes 30% less calendar time.")

(research trunk-based
  :name     "Trunk-based development"
  :track    product
  :cost     800
  :era      seed
  :requires (ci)
  :blurb    "Small changes land on one branch many times a day, so the Team ships 50% more often.")

(research platform-team
  :name     "Platform team"
  :track    product
  :cost     3_000
  :era      series-a
  :requires (containers)
  :blurb    "Unlocks the Platform team: it runs the Clusters and the pipeline, and halves deploy time.")

(research data-team
  :name     "Data team"
  :track    product
  :cost     10_000
  :era      series-b
  :requires (data-warehouse)
  :blurb    "Unlocks the Data team: report and AI Features cost 30% less, and a pipeline lags half as much.")

(research l4-lb
  :name     "L4 load balancing"
  :track    infrastructure
  :cost     400
  :era      seed
  :requires (lb-algorithms)
  :blurb    "A Load Balancer forwards TCP instead of reading HTTP: ten times the throughput, a fifth of the hop, and cheaper, with no retries.")

(research rate-limiting
  :name     "Rate limiting"
  :track    infrastructure
  :cost     1_800
  :era      series-a
  :requires (api-gateway)
  :blurb    "A token bucket on the Gateway: a burst up to the bucket passes whole, and the long-run average holds at the limit.")

(research esi
  :name     "Edge-side includes"
  :track    infrastructure
  :cost     3_000
  :era      series-a
  :requires (cdn)
  :insight  (page media)
  :blurb    "The CDN caches the shared shell of a logged-in page and fills in the personal parts at the edge, so 20% more page views hit.")

(research bot-management
  :name     "Bot management"
  :track    infrastructure
  :cost     2_500
  :era      series-a
  :requires (waf)
  :insight  (bot)
  :blurb    "A WAF that challenges suspicious clients instead of blocking them outright: it blocks the same bots and mistakes fewer real users for one.")

(research scheduled-scaling
  :name     "Scheduled scaling"
  :track    infrastructure
  :cost     9_000
  :era      series-b
  :requires (autoscaling)
  :blurb    "An Autoscaler adds copies before the known daily peak, so the copies are warm when it arrives.")

(research arm-instances
  :name  "ARM instances"
  :track infrastructure
  :cost  12_000
  :era   series-b
  :blurb "Unlocks the ARM instance family: the same vCPU and RAM as General for 0.8× the price.")

(research quantization
  :name     "Quantization"
  :track    infrastructure
  :cost     18_000
  :era      series-b
  :requires (model-serving)
  :insight  (ai)
  :blurb    "A GPU Node runs INT8 or INT4 weights: faster and smaller, and its answers are worth 5% or 15% less.")

(research continuous-batching
  :name     "Continuous batching"
  :track    infrastructure
  :cost     25_000
  :era      series-b
  :requires (model-serving)
  :insight  (ai)
  :blurb    "A GPU Node batches prompts as they arrive, so a larger batch raises throughput without raising the time to the first token.")

(research bulkheads
  :name     "Bulkheads"
  :track    reliability
  :cost     3_500
  :era      series-a
  :requires (circuit-breakers)
  :blurb    "A Link caps how many of its caller’s slots one dependency may hold: a slow dependency sheds its own calls and leaves the rest serving.")

(research graceful-degradation
  :name     "Graceful degradation"
  :track    reliability
  :cost     3_000
  :era      series-a
  :requires (feature-flags)
  :blurb    "A saturated App Server turns off its most expensive kinds first, so the cheap ones keep their latency and the expensive ones fail fast.")

(research hedged-requests
  :name     "Hedged requests"
  :track    reliability
  :cost     100_000
  :era      series-c
  :requires (tracing)
  :blurb    "A Link sends a second copy of a slow call after the p95 and keeps the faster answer: the tail drops and the callee sees 10% more calls.")

(research chaos-engineering
  :name     "Chaos engineering"
  :track    reliability
  :cost     300_000
  :era      pre-ipo
  :requires (runbooks)
  :blurb    "A scheduled experiment fails your weakest Node for a few seconds and names it: it earns Failure Insight and proves the Design survives.")

(research denormalization
  :name    "Denormalization"
  :track   performance
  :cost    3_000
  :era     series-a
  :insight (read write)
  :blurb   "A Database keeps a pre-joined copy: reads cost 30% less CPU, and every write costs 20% more.")

(research precompute
  :name    "Materialized views"
  :track   performance
  :cost    12_000
  :era     series-b
  :insight (report)
  :blurb   "A Database answers a report from a stored view: half the scan CPU, and the figures are as old as the refresh.")

(research binary-rpc
  :name  "Binary RPC between services"
  :track performance
  :cost  15_000
  :era   series-b
  :blurb "Services serialise calls as binary instead of text: half the serialization CPU on every backend call.")

(research outbox
  :name     "Transactional outbox"
  :track    data
  :cost     14_000
  :era      series-b
  :requires (queues)
  :insight  (buy job)
  :blurb    "A write and its event land in one transaction, and a relay publishes it: the copies stop diverging when a publish fails.")

(research expand-contract
  :name     "Expand and contract"
  :track    data
  :cost     10_000
  :era      series-b
  :requires (online-migrations)
  :blurb    "A schema change adds the new shape, backfills, then drops the old one: no table lock, so a migration can never stall writes.")

(research profiling
  :name     "Continuous profiling"
  :track    observability
  :cost     3_000
  :era      series-a
  :requires (tracing)
  :breadth  4
  :blurb    "Names the resource that limits each Node: CPU, workers, memory, connections, or disk.")

(research tail-sampling
  :name     "Tail-based sampling"
  :track    observability
  :cost     10_000
  :era      series-b
  :requires (tracing)
  :insight  (failure)
  :blurb    "Keeps slow and failed traces: twice the Failure Insight.")

(research rum
  :name           "Real user monitoring"
  :track          observability
  :cost           50_000
  :era            series-c
  :requires       (tracing)
  :insight        (page feed)
  :region-breadth 2
  :blurb          "Latency from the user’s side, split by device: desktop, mobile, and tablet.")

(research anomaly-detection
  :name     "Anomaly detection"
  :track    observability
  :cost     80_000
  :era      series-c
  :requires (alerting)
  :insight  (failure feed hook push)
  :blurb    "Forecasts tomorrow’s peak traffic and warns before an incident peaks.")

(research credential-protection
  :name     "Credential stuffing protection"
  :track    security
  :cost     2_500
  :era      series-a
  :requires (rate-limiting)
  :insight  (login bot)
  :blurb    "Blocks most of a credential-stuffing bot burst before it reaches login.")

(research pen-testing
  :name  "Penetration testing"
  :track security
  :cost  200_000
  :era   pre-ipo
  :blurb "Reveals the Design’s weakest incident kind once a calendar week.")

(research rightsizing
  :name     "Rightsizing report"
  :track    cost
  :cost     2_500
  :era      series-a
  :requires (metrics)
  :blurb    "Marks Nodes below 30% utilization at peak, so oversized boxes are easy to find.")

(research egress-optimization
  :name     "Egress optimization"
  :track    cost
  :cost     3_500
  :era      series-a
  :requires (object-storage)
  :blurb    "An R2-priced Object Storage variant: no egress to the internet.")

(research unit-economics
  :name  "Unit economics"
  :track cost
  :cost  8_000
  :era   series-b
  :blurb "Cost per served request, for each request kind.")

(research cost-allocation
  :name     "Cost allocation"
  :track    cost
  :cost     10_000
  :era      series-b
  :requires (unit-economics)
  :blurb    "Cost per Service and per Team, from the Nodes each Service owns.")

(research savings-plans
