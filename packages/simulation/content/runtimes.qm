(id LanguageId language-ids)

(id RuntimeId RUNTIME_IDS)

(id FrameworkId FRAMEWORK_IDS)

(def language-ids
  :type const
  ["php" "ruby" "node" "python" "go" "java" "csharp" "elixir" "rust" "zig" "haskell"])

(def blast-factor
  :type const
  (:request 1
   :whole   1.5
   :task    0.75))

(table languages
  :key      id
  :keep-key
  :type     (record LanguageId LanguageDef)
  [id         name       velocity  salary  hireTime  buildMinutes  sessionKB  armSpeed  armPortDh  blast]
  ["php"      "PHP"           1.2    0.85         1           0.5        130      0.95         16  "request"]
  ["ruby"     "Ruby"          1.1     1.1       1.5             1        340      0.95         24  "request"]
  ["node"     "Node.js"      1.15       1         1             3        420         1         12  "whole"]
  ["python"   "Python"       1.15    1.05         1             1        360      0.97         24  "request"]
  ["go"       "Go"           0.95    1.15       1.4           1.5        210      1.03          4  "request"]
  ["java"     "Java"          0.9    1.05       1.1             6        210      1.02          8  "request"]
  ["csharp"   "C#"              1       1       1.1             4        280      1.02          8  "request"]
  ["elixir"   "Elixir"          1     1.2       2.5             2        145         1         12  "request"]
  ["rust"     "Rust"          0.6    1.25         2            12         85      1.03          6  "task"]
  ["zig"      "Zig"           0.7    1.25         3             6         65         1          8  "whole"]
  ["haskell"  "Haskell"      1.15     1.4       2.5             8        180      0.93         32  "request"])

(def axes
  :type const
  ["throughput" "tail" "memory" "velocity" "resilience" "operability"])

(table runtimes
  :key      id
  :keep-key
  :type     (record RuntimeId RuntimeDef)
  [id              axes  glossary  language  name  model  speed  memoryMb  pool  threads  connections  persistent  startupSeconds  warmFrom  warmup  parallel  blocking  gc  connectionKB  hotReload  research  blurb  overheadFactor  velocity  build]
  ["mod_php"       (:throughput 1 :tail 3 :memory 1 :velocity 4 :resilience 5 :operability 5)  ["process-per-request" "shared-nothing"]  "php"  "Apache mod_php"  "process"  0.15  60  false  1  1  false  0  1  15  false  null  null  null  true  null  "Apache starts a process per request in flight, up to 150. Every process embeds PHP, so RAM runs out early."  -  -  -]
  ["php_fpm"       (:throughput 2 :tail 4 :memory 3 :velocity 4 :resilience 5 :operability 4)  ["process-per-request" "shared-nothing"]  "php"  "PHP-FPM"  "process"  0.15  40  true  1  1  false  0  1  15  false  null  null  null  true  "php-fpm"  "A fixed pool of PHP workers behind NGINX. Each waiting request holds a worker. Shared nothing: no leaks."  -  -  -]
  ["php_worker"    (:throughput 3 :tail 3 :memory 2 :velocity 5 :resilience 2 :operability 4)  ["process-per-request" "tech-debt"]  "php"  "PHP worker mode"  "process"  0.15  60  true  1  10  true  0  1  0  false  null  null  null  true  "php-worker-mode"  "FrankenPHP, RoadRunner or Octane: the app boots once, so the framework’s per-request overhead goes. Loses shared nothing, so memory leaks and state bleed become possible."  0  -  -]
  ["swoole"        (:throughput 4 :tail 3 :memory 3 :velocity 4 :resilience 3 :operability 3)  ["event-loop" "async-io"]  "php"  "Swoole"  "loop"  0.15  60  false  1  10  true  0  1  0  false  "loop"  null  20  true  "swoole"  "Coroutines on an event loop, async I/O like Node.js, and no framework overhead per request. Blocking extensions stall the loop. Holds realtime connections at 20 KB each."  0  -  -]
  ["puma"          (:throughput 3 :tail 3 :memory 2 :velocity 4 :resilience 4 :operability 2)  ["gil-global-interpreter-lock" "cold-start"]  "ruby"  "Puma"  "threads"  0.25  180  false  5  5  true  10  0.9  15  false  null  null  100  -  "lang-ruby"  "One process per core, 5 threads each. Threads overlap waits; the GVL keeps CPU on one core."  -  -  -]
  ["unicorn"       (:throughput 2 :tail 3 :memory 1 :velocity 5 :resilience 5 :operability 4)  ["process-per-request" "shared-nothing"]  "ruby"  "Unicorn"  "process"  0.25  180  true  1  1  true  10  0.9  15  false  null  null  null  -  "lang-ruby"  "A Rails process per slot: simple and robust, and memory-heavy. One waiting request holds a whole process, so it refuses realtime connections."  -  -  -]
  ["falcon"        (:throughput 4 :tail 4 :memory 2 :velocity 4 :resilience 4 :operability 1)  ["event-loop" "async-io"]  "ruby"  "Falcon"  "loop"  0.25  180  false  1  10  true  10  0.9  15  false  "loop"  null  100  -  "falcon"  "Fibers hold many idle connections per process. A gem that blocks stalls the loop. 100 KB per connection."  -  -  -]
  ["node"          (:throughput 4 :tail 2 :memory 4 :velocity 4 :resilience 2 :operability 4)  ["event-loop" "blast-radius"]  "node"  "Node.js"  "loop"  0.7  80  false  1  10  true  1  0.8  15  false  "loop"  null  20  -  "lang-node"  "One event loop. Waiting costs nothing, but it uses one core, and one slow request stalls every other."  -  -  -]
  ["node_cluster"  (:throughput 5 :tail 2 :memory 3 :velocity 4 :resilience 3 :operability 4)  ["event-loop" "vertical-and-horizontal-scaling"]  "node"  "Node.js cluster"  "loop"  0.7  80  false  1  10  true  1  0.8  15  false  "loop"  null  20  -  "node-cluster"  "One event loop per core. Uses every core; memory and connections grow with the cores."  -  -  -]
  ["bun"           (:throughput 5 :tail 2 :memory 3 :velocity 4 :resilience 2 :operability 5)  ["event-loop" "cold-start"]  "node"  "Bun"  "loop"  0.85  60  false  1  10  true  0  1  0  false  "loop"  null  20  -  "bun"  "A faster event loop with an instant start, so it autoscales and deploys better than Node.js. 60 MB and no startup. Less mature: a package that works on Node.js can break on it."  -  -  -]
  ["deno"          (:throughput 5 :tail 3 :memory 4 :velocity 3 :resilience 3 :operability 4)  ["event-loop" "dependency-scanning"]  "node"  "Deno"  "loop"  0.7  80  false  1  10  true  1  0.8  15  false  "loop"  null  20  -  "deno"  "Permissions block most supply-chain attacks, at 10% slower feature work: fewer packages are compatible. The same event loop as Node.js."  -  0.9  -]
  ["gunicorn"      (:throughput 2 :tail 4 :memory 2 :velocity 5 :resilience 5 :operability 3)  ["process-per-request" "gil-global-interpreter-lock"]  "python"  "Gunicorn"  "process"  0.2  120  true  1  1  true  5  0.95  15  false  null  null  null  -  "lang-python"  "A pool of sync workers, one request each. Like PHP-FPM with more memory per worker."  -  -  -]
  ["gevent"        (:throughput 4 :tail 4 :memory 3 :velocity 4 :resilience 3 :operability 2)  ["green-threads" "gil-global-interpreter-lock"]  "python"  "Gunicorn with gevent"  "green"  0.2  120  false  1  10  true  5  0.95  15  false  null  null  30  -  "gevent"  "Green threads hold many I/O waits per process, so a slow database stops holding a worker. Monkey patching can break a library. 30 KB per connection."  -  -  -]
  ["uvicorn"       (:throughput 3 :tail 2 :memory 4 :velocity 4 :resilience 3 :operability 3)  ["event-loop" "async-io" "gil-global-interpreter-lock"]  "python"  "Uvicorn ASGI"  "loop"  0.2  120  false  1  10  true  5  0.95  15  false  "loop"  null  30  -  "asgi"  "Async like Node.js, with slower CPU: a blocking call stalls the loop. Holds realtime connections at the design’s 30 KB each."  -  -  -]
  ["python_ft"     (:throughput 5 :tail 5 :memory 3 :velocity 3 :resilience 4 :operability 2)  ["thread-pool" "gil-global-interpreter-lock"]  "python"  "Free-threaded CPython"  "threads"  0.18  120  false  8  10  true  5  0.95  15  true  null  null  100  -  "free-threading"  "Real parallel threads on every core, 10% slower per thread, and a thread per connection is not cheap. C extensions that are not ready cost Dev Hours. 8 threads and 100 KB per connection."  -  -  -]
  ["pypy"          (:throughput 3 :tail 3 :memory 1 :velocity 5 :resilience 5 :operability 3)  ["process-per-request" "jit-warmup"]  "python"  "PyPy"  "process"  0.6  200  true  1  1  true  5  0.5  15  false  null  null  null  -  "pypy"  "Three times the pure-Python CPU of Gunicorn, after a JIT warmup. Poor C-extension support means no ML ecosystem bonus. 200 MB per worker."  -  -  -]
  ["go"            (:throughput 4 :tail 4 :memory 5 :velocity 3 :resilience 4 :operability 5)  ["green-threads" "gc-pause"]  "go"  "Go net/http"  "green"  1  30  false  1  10  true  0  1  15  true  null  (:pauseMs 1 :cpu 0.25)  10  -  "lang-go"  "Goroutines on every core. Waiting costs a few KB, not a worker. GC takes CPU when the heap is full."  -  -  -]
  ["fasthttp"      (:throughput 5 :tail 4 :memory 5 :velocity 2 :resilience 4 :operability 1)  ["green-threads" "http2-and-http3"]  "go"  "fasthttp"  "green"  1.25  30  false  1  10  true  0  1  0  true  null  (:pauseMs 1 :cpu 0.25)  10  -  "fasthttp"  "A quarter faster than net/http at 10% slower feature work: the API is not standard, some middleware does not work, and there is no HTTP/2."  -  0.9  -]
  ["tomcat"        (:throughput 5 :tail 3 :memory 1 :velocity 2 :resilience 4 :operability 4)  ["jit-warmup" "gc-pause" "cold-start"]  "java"  "Tomcat"  "threads"  1.1  500  false  200  10  true  20  0.3  30  true  null  (:pauseMs 30 :cpu 0.12)  1_024  -  "lang-java"  "One JVM, 200 threads on every core. Starts at 30% speed and warms for 30 s. Each waiting request holds a thread."  -  -  -]
  ["java_virtual"  (:throughput 4 :tail 5 :memory 1 :velocity 2 :resilience 4 :operability 4)  ["green-threads" "jit-warmup" "gc-pause"]  "java"  "Java virtual threads"  "green"  1.1  500  false  1  10  true  20  0.3  30  true  null  (:pauseMs 30 :cpu 0.12)  10  -  "virtual-threads"  "Waiting no longer holds a platform thread, so a slow database only adds latency. Native (JNI) calls still pin a carrier, and the JVM still warms for 30 s. Realtime connections cost 10 KB."  -  -  -]
  ["webflux"       (:throughput 5 :tail 3 :memory 5 :velocity 2 :resilience 3 :operability 3)  ["event-loop" "jit-warmup" "gc-pause"]  "java"  "Spring WebFlux"  "loop"  1.1  100  false  1  10  true  20  0.3  30  false  "loop"  (:pauseMs 30 :cpu 0.12)  10  -  "webflux"  "Very high concurrency on one loop per process, and 20% slower to build and debug. A blocking call stalls the loop, and the JVM still warms up. 400 MB."  -  0.8  -]
  ["graal"         (:throughput 4 :tail 5 :memory 3 :velocity 2 :resilience 4 :operability 3)  ["cold-start" "jit-warmup" "thread-pool"]  "java"  "GraalVM native image"  "threads"  0.8  200  false  200  10  true  0  1  0  true  null  (:pauseMs 30 :cpu 0.12)  1_024  -  "graal-native"  "Starts in under 100 ms with no warmup at 60% of the JVM’s memory and 0.80× its speed, with builds three times as long. A thread per connection, like Tomcat. Great for Serverless Functions."  -  -  3]
  ["kestrel"       (:throughput 5 :tail 4 :memory 3 :velocity 3 :resilience 4 :operability 3)  ["async-io" "jit-warmup" "gc-pause"]  "csharp"  "Kestrel"  "async"  1.1  150  false  1  10  true  3  0.6  15  true  null  (:pauseMs 15 :cpu 0.1)  10  -  "lang-csharp"  ".NET async on every core. Waiting holds no thread. A shorter JIT warmup than the JVM."  -  -  -]
  ["native_aot"    (:throughput 3 :tail 5 :memory 4 :velocity 3 :resilience 4 :operability 3)  ["cold-start" "async-io"]  "csharp"  "Native AOT"  "async"  0.9  100  false  1  10  true  0  1  0  true  null  (:pauseMs 15 :cpu 0.1)  10  -  "native-aot"  "No JIT, so it starts at full speed, and smaller: 100 MB. 0.90× the speed, and reflection-heavy libraries need Dev Hours."  -  -  -]
  ["beam"          (:throughput 2 :tail 5 :memory 4 :velocity 4 :resilience 5 :operability 3)  ["green-threads" "blast-radius"]  "elixir"  "BEAM"  "green"  0.45  100  false  1  10  true  3  1  15  true  null  null  5  true  "lang-elixir"  "Preemptive processes on every core. No request stalls another, and each process collects its own garbage. Slow CPU."  -  -  -]
  ["tokio"         (:throughput 5 :tail 4 :memory 5 :velocity 1 :resilience 4 :operability 4)  ["async-io" "event-loop"]  "rust"  "Tokio"  "async"  1.4  10  false  1  10  true  0  1  15  true  "worker"  null  5  -  "lang-rust"  "Async tasks on every core, no GC, little memory. A CPU-heavy task blocks one worker thread."  -  -  -]
  ["zig"           (:throughput 5 :tail 4 :memory 4 :velocity 2 :resilience 2 :operability 2)  ["thread-pool" "blast-radius"]  "zig"  "Zig threaded server"  "threads"  1.3  24  false  64  10  true  0  1  0  true  null  null  256  -  "lang-zig"  "Native code with explicit allocators and no GC. A 64-thread server uses every core, but each waiting request holds a thread. Persistent state can leak."  -  -  -]
  ["warp"          (:throughput 4 :tail 3 :memory 3 :velocity 4 :resilience 4 :operability 1)  ["green-threads" "gc-pause"]  "haskell"  "Haskell (GHC + Warp)"  "green"  0.85  80  false  1  10  true  1  1  0  true  null  (:pauseMs 12 :cpu 0.15)  16  -  "lang-haskell"  "Warp runs lightweight GHC threads across cores. Productive specialists, but slower builds and hiring. I/O waits hold no OS thread; shared-heap GC adds pauses and CPU cost."  -  -  -])

(constants apache
  (max-workers 150)
  (spare 5))

(def opcache-speed 2.5)

(constants yjit
  (speed 1.3)
  (memory 1.2))

(constants jemalloc
  (speed 1.05)
  (memory 1.05))

(constants php
  (jit-speed 1.05)
  (jit-heavy 1.6))

(def nif-speed 3)

(def cpu-heavy-kinds
  :type (array RequestKind)
  ["upload" "report" "job"])

(constants worker
  (threads 4)
  (thread-mb 10))

(def recycle-cycle-seconds 1_800)

(constants libuv
  (threads 4)
  (thread-mb 2))

(constants spawn
  (blocking-threads 8)
  (blocking-thread-mb 2))

(def ml-ai-bonus 1.2)

(def elixir-hot-upgrade-dev-hours 4)

(def sim-seconds-per-dev-hour 0.3125)

(def default-fpm-workers 5)

