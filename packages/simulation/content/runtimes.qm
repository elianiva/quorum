(def blast-factor
  :type const
  (:request 1
   :whole   1.5
   :task    0.75))

(table languages
  :key      id
  :ids      language-ids
  :id-type  LanguageId
  :keep-key
  :type     (record LanguageId LanguageDef)
  [id       name       velocity  salary  hireTime  buildMinutes  sessionKB  armSpeed  armPortDh  blast]
  [php      "PHP"           1.2    0.85         1           0.5        130      0.95         16  "request"]
  [ruby     "Ruby"          1.1     1.1       1.5             1        340      0.95         24  "request"]
  [node     "Node.js"      1.15       1         1             3        420         1         12  "whole"]
  [python   "Python"       1.15    1.05         1             1        360      0.97         24  "request"]
  [go       "Go"           0.95    1.15       1.4           1.5        210      1.03          4  "request"]
  [java     "Java"          0.9    1.05       1.1             6        210      1.02          8  "request"]
  [csharp   "C#"              1       1       1.1             4        280      1.02          8  "request"]
  [elixir   "Elixir"          1     1.2       2.5             2        145         1         12  "request"]
  [rust     "Rust"          0.6    1.25         2            12         85      1.03          6  "task"]
  [zig      "Zig"           0.7    1.25         3             6         65         1          8  "whole"]
  [haskell  "Haskell"      1.15     1.4       2.5             8        180      0.93         32  "request"])

(def axes
  :type const
  ["throughput" "tail" "memory" "velocity" "resilience" "operability"])

(constants runtime
  (defaults
    :satisfies (partial RuntimeDef)
    (:pool       false
     :threads    1
     :persistent true
     :parallel   false
     :blocking   null
     :gc         null)))

(records runtimes
  :defaults runtime-defaults
  :key      id
  :ids      runtime-ids
  :id-type  RuntimeId
  :refs     (:language languages :glossary glossary)
  :type     (record RuntimeId RuntimeDef)
  (mod_php
    :axes           (:throughput 1 :tail 3 :memory 1 :velocity 4 :resilience 5 :operability 5)
    :glossary       [process-per-request shared-nothing]
    :language       php
    :name           "Apache mod_php"
    :model          "process"
    :speed          0.15
    :memoryMb       60
    :connections    1
    :persistent     false
    :startupSeconds 0
    :warmFrom       1
    :warmup         15
    :connectionKB   null
    :hotReload      true
    :research       null
    :blurb          "Apache starts a process per request in flight, up to 150. Every process embeds PHP, so RAM runs out early.")
  (php_fpm
    :axes           (:throughput 2 :tail 4 :memory 3 :velocity 4 :resilience 5 :operability 4)
    :glossary       [process-per-request shared-nothing]
    :language       php
    :name           "PHP-FPM"
    :model          "process"
    :speed          0.15
    :memoryMb       40
    :pool           true
    :connections    1
    :persistent     false
    :startupSeconds 0
    :warmFrom       1
    :warmup         15
    :connectionKB   null
    :hotReload      true
    :research       "php-fpm"
    :blurb          "A fixed pool of PHP workers behind NGINX. Each waiting request holds a worker. Shared nothing: no leaks.")
  (php_worker
    :axes           (:throughput 3 :tail 3 :memory 2 :velocity 5 :resilience 2 :operability 4)
    :glossary       [process-per-request tech-debt]
    :language       php
    :name           "PHP worker mode"
    :model          "process"
    :speed          0.15
    :memoryMb       60
    :pool           true
    :connections    10
    :startupSeconds 0
    :warmFrom       1
    :warmup         0
    :connectionKB   null
    :hotReload      true
    :research       "php-worker-mode"
    :blurb          "FrankenPHP, RoadRunner or Octane: the app boots once, so the framework’s per-request overhead goes. Loses shared nothing, so memory leaks and state bleed become possible."
    :overheadFactor 0)
  (swoole
    :axes           (:throughput 4 :tail 3 :memory 3 :velocity 4 :resilience 3 :operability 3)
    :glossary       [event-loop async-io]
    :language       php
    :name           "Swoole"
    :model          "loop"
    :speed          0.15
    :memoryMb       60
    :connections    10
    :startupSeconds 0
    :warmFrom       1
    :warmup         0
    :blocking       "loop"
    :connectionKB   20
    :hotReload      true
    :research       "swoole"
    :blurb          "Coroutines on an event loop, async I/O like Node.js, and no framework overhead per request. Blocking extensions stall the loop. Holds realtime connections at 20 KB each."
    :overheadFactor 0)
  (puma
    :axes           (:throughput 3 :tail 3 :memory 2 :velocity 4 :resilience 4 :operability 2)
    :glossary       [gil-global-interpreter-lock cold-start]
    :language       ruby
    :name           "Puma"
    :model          "threads"
    :speed          0.25
    :memoryMb       180
    :threads        5
    :connections    5
    :startupSeconds 10
    :warmFrom       0.9
    :warmup         15
    :connectionKB   100
    :research       "lang-ruby"
    :blurb          "One process per core, 5 threads each. Threads overlap waits; the GVL keeps CPU on one core.")
  (unicorn
    :axes           (:throughput 2 :tail 3 :memory 1 :velocity 5 :resilience 5 :operability 4)
    :glossary       [process-per-request shared-nothing]
    :language       ruby
    :name           "Unicorn"
    :model          "process"
    :speed          0.25
    :memoryMb       180
    :pool           true
    :connections    1
    :startupSeconds 10
    :warmFrom       0.9
    :warmup         15
    :connectionKB   null
    :research       "lang-ruby"
    :blurb          "A Rails process per slot: simple and robust, and memory-heavy. One waiting request holds a whole process, so it refuses realtime connections.")
  (falcon
    :axes           (:throughput 4 :tail 4 :memory 2 :velocity 4 :resilience 4 :operability 1)
    :glossary       [event-loop async-io]
    :language       ruby
    :name           "Falcon"
    :model          "loop"
    :speed          0.25
    :memoryMb       180
    :connections    10
    :startupSeconds 10
    :warmFrom       0.9
    :warmup         15
    :blocking       "loop"
    :connectionKB   100
    :research       "falcon"
    :blurb          "Fibers hold many idle connections per process. A gem that blocks stalls the loop. 100 KB per connection.")
  (node
    :axes           (:throughput 4 :tail 2 :memory 4 :velocity 4 :resilience 2 :operability 4)
    :glossary       [event-loop blast-radius]
    :language       node
    :name           "Node.js"
    :model          "loop"
    :speed          0.7
    :memoryMb       80
    :connections    10
    :startupSeconds 1
    :warmFrom       0.8
    :warmup         15
    :blocking       "loop"
    :connectionKB   20
    :research       "lang-node"
    :blurb          "One event loop. Waiting costs nothing, but it uses one core, and one slow request stalls every other.")
  (node_cluster
    :axes           (:throughput 5 :tail 2 :memory 3 :velocity 4 :resilience 3 :operability 4)
    :glossary       [event-loop vertical-and-horizontal-scaling]
    :language       node
    :name           "Node.js cluster"
    :model          "loop"
    :speed          0.7
    :memoryMb       80
    :connections    10
    :startupSeconds 1
    :warmFrom       0.8
    :warmup         15
    :blocking       "loop"
    :connectionKB   20
    :research       "node-cluster"
    :blurb          "One event loop per core. Uses every core; memory and connections grow with the cores.")
  (bun
    :axes           (:throughput 5 :tail 2 :memory 3 :velocity 4 :resilience 2 :operability 5)
    :glossary       [event-loop cold-start]
    :language       node
    :name           "Bun"
    :model          "loop"
    :speed          0.85
    :memoryMb       60
    :connections    10
    :startupSeconds 0
    :warmFrom       1
    :warmup         0
    :blocking       "loop"
    :connectionKB   20
    :research       "bun"
    :blurb          "A faster event loop with an instant start, so it autoscales and deploys better than Node.js. 60 MB and no startup. Less mature: a package that works on Node.js can break on it.")
  (deno
    :axes           (:throughput 5 :tail 3 :memory 4 :velocity 3 :resilience 3 :operability 4)
    :glossary       [event-loop dependency-scanning]
    :language       node
    :name           "Deno"
    :model          "loop"
    :speed          0.7
    :memoryMb       80
    :connections    10
    :startupSeconds 1
    :warmFrom       0.8
    :warmup         15
    :blocking       "loop"
    :connectionKB   20
    :research       "deno"
    :blurb          "Permissions block most supply-chain attacks, at 10% slower feature work: fewer packages are compatible. The same event loop as Node.js."
    :velocity       0.9)
  (gunicorn
    :axes           (:throughput 2 :tail 4 :memory 2 :velocity 5 :resilience 5 :operability 3)
    :glossary       [process-per-request gil-global-interpreter-lock]
    :language       python
    :name           "Gunicorn"
    :model          "process"
    :speed          0.2
    :memoryMb       120
    :pool           true
    :connections    1
    :startupSeconds 5
    :warmFrom       0.95
    :warmup         15
    :connectionKB   null
    :research       "lang-python"
    :blurb          "A pool of sync workers, one request each. Like PHP-FPM with more memory per worker.")
  (gevent
    :axes           (:throughput 4 :tail 4 :memory 3 :velocity 4 :resilience 3 :operability 2)
    :glossary       [green-threads gil-global-interpreter-lock]
    :language       python
    :name           "Gunicorn with gevent"
    :model          "green"
    :speed          0.2
    :memoryMb       120
    :connections    10
    :startupSeconds 5
    :warmFrom       0.95
    :warmup         15
    :connectionKB   30
    :research       "gevent"
    :blurb          "Green threads hold many I/O waits per process, so a slow database stops holding a worker. Monkey patching can break a library. 30 KB per connection.")
  (uvicorn
    :axes           (:throughput 3 :tail 2 :memory 4 :velocity 4 :resilience 3 :operability 3)
    :glossary       [event-loop async-io gil-global-interpreter-lock]
    :language       python
    :name           "Uvicorn ASGI"
    :model          "loop"
    :speed          0.2
    :memoryMb       120
    :connections    10
    :startupSeconds 5
    :warmFrom       0.95
    :warmup         15
    :blocking       "loop"
    :connectionKB   30
    :research       "asgi"
    :blurb          "Async like Node.js, with slower CPU: a blocking call stalls the loop. Holds realtime connections at the design’s 30 KB each.")
  (python_ft
    :axes           (:throughput 5 :tail 5 :memory 3 :velocity 3 :resilience 4 :operability 2)
    :glossary       [thread-pool gil-global-interpreter-lock]
    :language       python
    :name           "Free-threaded CPython"
    :model          "threads"
    :speed          0.18
    :memoryMb       120
    :threads        8
    :connections    10
    :startupSeconds 5
    :warmFrom       0.95
    :warmup         15
    :parallel       true
    :connectionKB   100
    :research       "free-threading"
    :blurb          "Real parallel threads on every core, 10% slower per thread, and a thread per connection is not cheap. C extensions that are not ready cost Dev Hours. 8 threads and 100 KB per connection.")
  (pypy
    :axes           (:throughput 3 :tail 3 :memory 1 :velocity 5 :resilience 5 :operability 3)
    :glossary       [process-per-request jit-warmup]
    :language       python
    :name           "PyPy"
    :model          "process"
    :speed          0.6
    :memoryMb       200
    :pool           true
    :connections    1
    :startupSeconds 5
    :warmFrom       0.5
    :warmup         15
    :connectionKB   null
    :research       "pypy"
    :blurb          "Three times the pure-Python CPU of Gunicorn, after a JIT warmup. Poor C-extension support means no ML ecosystem bonus. 200 MB per worker.")
  (go
    :axes           (:throughput 4 :tail 4 :memory 5 :velocity 3 :resilience 4 :operability 5)
    :glossary       [green-threads gc-pause]
    :language       go
    :name           "Go net/http"
    :model          "green"
    :speed          1
    :memoryMb       30
    :connections    10
    :startupSeconds 0
    :warmFrom       1
    :warmup         15
    :parallel       true
    :gc             (:pauseMs 1 :cpu 0.25)
    :connectionKB   10
    :research       "lang-go"
    :blurb          "Goroutines on every core. Waiting costs a few KB, not a worker. GC takes CPU when the heap is full.")
  (fasthttp
    :axes           (:throughput 5 :tail 4 :memory 5 :velocity 2 :resilience 4 :operability 1)
    :glossary       [green-threads http2-and-http3]
    :language       go
    :name           "fasthttp"
    :model          "green"
    :speed          1.25
    :memoryMb       30
    :connections    10
    :startupSeconds 0
    :warmFrom       1
    :warmup         0
    :parallel       true
    :gc             (:pauseMs 1 :cpu 0.25)
    :connectionKB   10
    :research       "fasthttp"
    :blurb          "A quarter faster than net/http at 10% slower feature work: the API is not standard, some middleware does not work, and there is no HTTP/2."
    :velocity       0.9)
  (tomcat
    :axes           (:throughput 5 :tail 3 :memory 1 :velocity 2 :resilience 4 :operability 4)
    :glossary       [jit-warmup gc-pause cold-start]
    :language       java
    :name           "Tomcat"
    :model          "threads"
    :speed          1.1
    :memoryMb       500
    :threads        200
    :connections    10
    :startupSeconds 20
    :warmFrom       0.3
    :warmup         30
    :parallel       true
    :gc             (:pauseMs 30 :cpu 0.12)
    :connectionKB   1_024
    :research       "lang-java"
    :blurb          "One JVM, 200 threads on every core. Starts at 30% speed and warms for 30 s. Each waiting request holds a thread.")
  (java_virtual
    :axes           (:throughput 4 :tail 5 :memory 1 :velocity 2 :resilience 4 :operability 4)
    :glossary       [green-threads jit-warmup gc-pause]
    :language       java
    :name           "Java virtual threads"
    :model          "green"
    :speed          1.1
    :memoryMb       500
    :connections    10
    :startupSeconds 20
    :warmFrom       0.3
    :warmup         30
    :parallel       true
    :gc             (:pauseMs 30 :cpu 0.12)
    :connectionKB   10
    :research       "virtual-threads"
    :blurb          "Waiting no longer holds a platform thread, so a slow database only adds latency. Native (JNI) calls still pin a carrier, and the JVM still warms for 30 s. Realtime connections cost 10 KB.")
  (webflux
    :axes           (:throughput 5 :tail 3 :memory 5 :velocity 2 :resilience 3 :operability 3)
    :glossary       [event-loop jit-warmup gc-pause]
    :language       java
    :name           "Spring WebFlux"
    :model          "loop"
    :speed          1.1
    :memoryMb       100
    :connections    10
    :startupSeconds 20
    :warmFrom       0.3
    :warmup         30
    :blocking       "loop"
    :gc             (:pauseMs 30 :cpu 0.12)
    :connectionKB   10
    :research       "webflux"
    :blurb          "Very high concurrency on one loop per process, and 20% slower to build and debug. A blocking call stalls the loop, and the JVM still warms up. 400 MB."
    :velocity       0.8)
  (graal
    :axes           (:throughput 4 :tail 5 :memory 3 :velocity 2 :resilience 4 :operability 3)
    :glossary       [cold-start jit-warmup thread-pool]
    :language       java
    :name           "GraalVM native image"
