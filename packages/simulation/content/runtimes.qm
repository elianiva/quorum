    :glossary [tech-debt]
    :name     "Express"
    :language node
    :overhead 1.1
    :velocity 1.2
    :memoryMb 10
    :blurb    "Minimal and everywhere. 1.1× CPU, and middleware sprawl grows tech debt 10% faster."
    :debt     1.1)
  (django
    :axes          (:throughput 3 :tail 3 :memory 3 :velocity 5 :resilience 3 :operability 3)
    :glossary      [n1-query]
    :name          "Django"
    :language      python
    :overhead      1.4
    :velocity      1.4
    :memoryMb      30
    :orm           true
    :blurb         "Ships features fast, and internal tools cost 30% fewer Dev Hours with the admin site. 1.4× CPU and N+1 queries."
