    :workerHours    0.8
    :workerOverhead 1.1)
  (rails
    :axes     (:throughput 3 :tail 3 :memory 2 :velocity 5 :resilience 3 :operability 3)
    :glossary [n1-query]
    :name     "Rails"
    :language ruby
    :overhead 1.5
    :velocity 1.5
    :memoryMb 70
    :orm      true
    :value    (:page 1.2)
