  :key id
  [id        label       pauseMs  speed  memory]
  [g1        "G1"             30      1       1]
  [parallel  "Parallel"      150   1.05    0.95]
  [zgc       "ZGC"             1    0.9    1.15])

(table gogc
  [gogc  memory  cpu]
  [  50     0.7    2]
  [ 100       1    1]
  [ 200     1.5  0.5])

(def orm-reads 3)

(table pm-modes
  :key id
  [id        label        spares  spawnShare  spawnMs]
  [static    "Static"     null             0        0]
  [dynamic   "Dynamic"    2             0.02       20]
  [ondemand  "On demand"  0              0.1       50])

(def beam-crashes-per-requests 100)

(def let-it-crash 1_000)

(def jvm-insight 0.25)

(def pool-limits
  :type const
  (:min 1
   :max 400))
