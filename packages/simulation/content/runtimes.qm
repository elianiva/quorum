    :blurb          "No JIT, so it starts at full speed, and smaller: 100 MB. 0.90× the speed, and reflection-heavy libraries need Dev Hours.")
  (beam
    :axes           (:throughput 2 :tail 5 :memory 4 :velocity 4 :resilience 5 :operability 3)
    :glossary       [green-threads blast-radius]
    :language       elixir
    :name           "BEAM"
    :model          "green"
    :speed          0.45
    :memoryMb       100
    :connections    10
    :startupSeconds 3
    :warmFrom       1
    :warmup         15
    :parallel       true
    :connectionKB   5
    :hotReload      true
    :research       "lang-elixir"
    :blurb          "Preemptive processes on every core. No request stalls another, and each process collects its own garbage. Slow CPU.")
  (tokio
    :axes           (:throughput 5 :tail 4 :memory 5 :velocity 1 :resilience 4 :operability 4)
    :glossary       [async-io event-loop]
    :language       rust
    :name           "Tokio"
    :model          "async"
    :speed          1.4
    :memoryMb       10
    :connections    10
    :startupSeconds 0
    :warmFrom       1
    :warmup         15
    :parallel       true
    :blocking       "worker"
    :connectionKB   5
    :research       "lang-rust"
    :blurb          "Async tasks on every core, no GC, little memory. A CPU-heavy task blocks one worker thread.")
  (zig
    :axes           (:throughput 5 :tail 4 :memory 4 :velocity 2 :resilience 2 :operability 2)
    :glossary       [thread-pool blast-radius]
    :language       zig
    :name           "Zig threaded server"
    :model          "threads"
    :speed          1.3
    :memoryMb       24
    :threads        64
    :connections    10
    :startupSeconds 0
    :warmFrom       1
    :warmup         0
    :parallel       true
    :connectionKB   256
    :research       "lang-zig"
    :blurb          "Native code with explicit allocators and no GC. A 64-thread server uses every core, but each waiting request holds a thread. Persistent state can leak.")
  (warp
    :axes           (:throughput 4 :tail 3 :memory 3 :velocity 4 :resilience 4 :operability 1)
    :glossary       [green-threads gc-pause]
    :language       haskell
    :name           "Haskell (GHC + Warp)"
    :model          "green"
    :speed          0.85
    :memoryMb       80
    :connections    10
    :startupSeconds 1
    :warmFrom       1
    :warmup         0
    :parallel       true
    :gc             (:pauseMs 12 :cpu 0.15)
    :connectionKB   16
    :research       "lang-haskell"
    :blurb          "Warp runs lightweight GHC threads across cores. Productive specialists, but slower builds and hiring. I/O waits hold no OS thread; shared-heap GC adds pauses and CPU cost."))

(constants apache
  (max-workers 150)
  (spare 5))

(def opcache-speed 2.5)

(constants yjit
  (speed 1.3)
  (memory 1.2))

(constants jemalloc
  (speed 1.05)
  (memory 1.05))

(constants php
  (jit-speed 1.05)
  (jit-heavy 1.6))

(def nif-speed 3)

(def cpu-heavy-kinds
  :type (array RequestKind)
  ["upload" "report" "job"])

(constants worker
  (threads 4)
  (thread-mb 10))

(def recycle-cycle-seconds 1_800)

(constants libuv
  (threads 4)
  (thread-mb 2))

(constants spawn
  (blocking-threads 8)
  (blocking-thread-mb 2))

(def ml-ai-bonus 1.2)

(def elixir-hot-upgrade-dev-hours 4)

(def sim-seconds-per-dev-hour 0.3125)

(def default-fpm-workers 5)

(constants framework
  (defaults :satisfies (partial FrameworkDef) (:orm false :value (record) :startupSeconds 0)))

(records frameworks
  :defaults framework-defaults
  :key      id
  :ids      framework-ids
  :id-type  FrameworkId
  :refs     (:language languages :glossary glossary)
  :type     (record FrameworkId FrameworkDef)
  (none
    :axes     (:throughput 5 :tail 4 :memory 5 :velocity 1 :resilience 2 :operability 5)
    :glossary [tech-debt]
    :name     "No framework"
    :language null
    :overhead 1
    :velocity 0.8
    :memoryMb 0
    :blurb    "Fast to run, slow to build features.")
  (jetzig
    :axes         (:throughput 3 :tail 4 :memory 3 :velocity 5 :resilience 3 :operability 2)
    :glossary     []
    :name         "Jetzig"
    :language     zig
    :overhead     1.3
    :velocity     1.4
    :memoryMb     25
    :blurb        "File-based routes, templates, database queries and background jobs in one box: features ship fast. 1.3× CPU and 25 MB per process, on a young toolchain."
    :coordination 0.85
    :workerHours  0.8)
  (tokamak
    :axes         (:throughput 5 :tail 4 :memory 5 :velocity 4 :resilience 3 :operability 2)
    :glossary     [conways-law]
    :name         "Tokamak"
    :language     zig
    :overhead     1.05
    :velocity     1.2
    :memoryMb     5
    :blurb        "A dependency-injection container over http.zig: explicit wiring cuts coordination and tech debt. 1.05× CPU and 5 MB per process, with a small ecosystem."
    :coordination 0.7
    :debt         0.9)
  (servant
    :axes         (:throughput 4 :tail 4 :memory 5 :velocity 3 :resilience 4 :operability 2)
    :glossary     [tech-debt]
    :name         "Servant"
    :language     haskell
    :overhead     1
    :velocity     1.1
    :memoryMb     2
    :blurb        "The API type is the contract: routing, clients and docs follow from it, so teams coordinate less and drift less. 1.0× CPU and 2 MB per process, with a type-level learning curve."
    :coordination 0.7
    :debt         0.8)
  (ihp
    :axes         (:throughput 3 :tail 3 :memory 2 :velocity 5 :resilience 4 :operability 1)
    :glossary     [conways-law]
    :name         "IHP"
    :language     haskell
    :overhead     1.3
    :velocity     1.4
    :memoryMb     40
    :blurb        "Batteries included: code generation, a type-safe query builder and a built-in job queue. Features ship fast at 1.3× CPU and 40 MB per process, on a Nix-based toolchain."
    :coordination 0.9
    :workerHours  0.8)
  (laravel
    :axes           (:throughput 2 :tail 3 :memory 4 :velocity 5 :resilience 3 :operability 3)
    :glossary       [n1-query]
    :name           "Laravel"
    :language       php
    :overhead       1.8
    :velocity       1.45
    :memoryMb       10
    :orm            true
