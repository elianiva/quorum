(def SEARCH_QPS 400)

(def SEARCH_REFRESH :type const
  [(:seconds 1 :capacity 1 :stale 0)
   (:seconds 5 :capacity 1.1 :stale 0.05)
   (:seconds 60 :capacity 1.3 :stale 0.25)])

(def SEARCH_SHARDS :type const [1 2 4])
(def SEARCH_REPLICAS :type const [0 1 2])
(def SEARCH_FANOUT 0.2)

(def SEARCH_HEAPS :type const
  (:small (:name "25% of RAM" :capacity 1 :tailP 0.05 :tailMs 150)
   :half (:name "50% of RAM" :capacity 1 :tailP 0 :tailMs 0)
   :large (:name "75% of RAM" :capacity 0.85 :tailP 0.02 :tailMs 400)))

(def SEARCH_VARIANTS :type const
  (:elasticsearch (:name "Elasticsearch"
                   :jvm true
                   :capacity 1
                   :fixedMs 15
                   :burn 1
                   :relevance 0
                   :cap 0)
   :opensearch (:name "OpenSearch" :jvm true :capacity 1 :fixedMs 15 :burn 1 :relevance 0 :cap 0)
   :meilisearch (:name "Meilisearch"
                 :jvm false
                 :capacity 1.5
                 :fixedMs 8
                 :burn 0.6
                 :relevance 0.0000005
                 :cap 0.25)))
(def SEARCH_INDEX_SHARE 0.3)
(def SEARCH_COPY_MINUTES_PER_GB 0.5)

(def searchGlossary :type "ReadonlyArray<string>" ["inverted-index"])
