(id PolicyId POLICY_IDS)

(constants dev
  (hours-per-day 8)
  (environment-ramp 0.5))

(def founder-output 0.8)

(table policies
  :key      id
  :keep-key
  :type     (record PolicyId PolicyDef)
  [id           label        velocity  debt  badDeploy  deploysPerDay  paydown]
  ["move-fast"  "Move fast"       1.3  0.06        1.5             16        0]
  ["balanced"   "Balanced"          1  0.03          1              8        0]
  ["quality"    "Quality"         0.8  0.01        0.5              4      0.1])

(def salary-base-per-second 0.4)

(def signing-base 2_000)

(def hire-days 1)

(constants ramp
  (output 0.3)
  (days 7))

(def layoff-morale 0.9)

(def morale-days 7)

(constants learn
  (days 7)
  (output 0.5)
  (cost 0.25))

(def foreign-output 0.7)

(def coordination 0.08)

(def retrograde 0.0004)

(def kloc-per-dh 0.5)

(def refactor-per-dh 0.02)

(def unstructured-debt 0.01)

(def hotfix-debt 0.02)

(constants rush
  (debt 0.02)
  (bug-chance 0.1))

(constants upkeep
  (share 0.4)
  (half 2_000)
  (ceiling 0.6))

(table outcome-bands
  :type OutcomeBands
  [lo    hi]
  [ 0.6   1.4]
  [-0.1   0.2]
  [-0.5  -0.1])

(def market-gain-cap 2)

(def adoption-days 7)

(constants lift
  (spread 1)
  (z-score 1.96)
  (min-rollout 0.05)
  (max-rollout 0.5))

(constants block
  (remind-days 1)
  (size-at 8))

(def mood-start 1)

(def unhappy-mood 0.35)

(def content-mood 0.7)

(def freeze-mood-days 7)

(def pay-gap-mood-days 3)

(def time-off-days 3)

(def hiring-pipeline 0.7)

(def trunk-frequency 1.5)

(constants security
  (team-supply-chain 0.5)
  (team-grace 2))

(def work-minutes 480)

(def manual-deploy-minutes 30)

(def ci-deploy-minutes 5)

(def verify-minutes 15)

(constants bad
  (deploy-base :type (array number) [0 0.1 0.1])
  (deploy-errors 0.08)
  (deploy-max 0.4))

(def tests-factor 0.3)

(def code-review-factor 0.2)

(def build-cache 0.75)

(def static-analysis-factor 0.2)

(constants formal
  (verification-factor 0.5)
  (verification-velocity 0.85))

(def fix-bugs-share 0.25)

(def shared-db-coordination 0.5)

(def service-handoff-dh 8)

(def datastore-move-dh 16)

(constants engine
  (factor 0.8)
  (copy-minutes-per-gb 1))

(def session-state-crashes 0.05)

(def paying-share 0.05)

(def plan-per-day 24)
