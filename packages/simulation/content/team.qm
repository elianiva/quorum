(types "../catalog/team.ts" PolicyId PolicyDef)

(constants dev
  (hours-per-day 8)
  (environment-ramp 0.5))

(def FOUNDER_OUTPUT 0.8)

(table policies
  :key      id
  :keep-key
  :type     (record PolicyId PolicyDef)
  [id           label        velocity  debt  badDeploy  deploysPerDay  paydown]
  ["move-fast"  "Move fast"       1.3  0.06        1.5             16        0]
  ["balanced"   "Balanced"          1  0.03          1              8        0]
  ["quality"    "Quality"         0.8  0.01        0.5              4      0.1])

(def SALARY_BASE_PER_SECOND 0.4)

(def SIGNING_BASE 2_000)

(def HIRE_DAYS 1)

(constants ramp
  (output 0.3)
  (days 7))

(def LAYOFF_MORALE 0.9)

(def MORALE_DAYS 7)

(constants learn
  (days 7)
  (output 0.5)
  (cost 0.25))

(def FOREIGN_OUTPUT 0.7)

(def COORDINATION 0.08)

(def RETROGRADE 0.0004)

(def KLOC_PER_DH 0.5)

(def REFACTOR_PER_DH 0.02)

(def UNSTRUCTURED_DEBT 0.01)

(def HOTFIX_DEBT 0.02)

(constants rush
  (debt 0.02)
  (bug-chance 0.1))

(constants upkeep
  (share 0.4)
  (half 2_000)
  (ceiling 0.6))

(table outcome-bands
  :type OutcomeBands
  [lo    hi]
  [ 0.6   1.4]
  [-0.1   0.2]
  [-0.5  -0.1])

(def MARKET_GAIN_CAP 2)

(def ADOPTION_DAYS 7)

(constants lift
  (spread 1)
  (z-score 1.96)
  (min-rollout 0.05)
  (max-rollout 0.5))

(constants block
  (remind-days 1)
  (size-at 8))

(def MOOD_START 1)

(def UNHAPPY_MOOD 0.35)

(def CONTENT_MOOD 0.7)

(def FREEZE_MOOD_DAYS 7)

(def PAY_GAP_MOOD_DAYS 3)

(def TIME_OFF_DAYS 3)

(def HIRING_PIPELINE 0.7)

(def TRUNK_FREQUENCY 1.5)

(constants security
  (team-supply-chain 0.5)
  (team-grace 2))

(def WORK_MINUTES 480)

(def MANUAL_DEPLOY_MINUTES 30)

(def CI_DEPLOY_MINUTES 5)

(def VERIFY_MINUTES 15)

(constants bad
  (deploy-base :type (array number) [0 0.1 0.1])
  (deploy-errors 0.08)
  (deploy-max 0.4))

(def TESTS_FACTOR 0.3)

(def CODE_REVIEW_FACTOR 0.2)

(def BUILD_CACHE 0.75)

(def STATIC_ANALYSIS_FACTOR 0.2)

(constants formal
  (verification-factor 0.5)
  (verification-velocity 0.85))

(def FIX_BUGS_SHARE 0.25)

(def SHARED_DB_COORDINATION 0.5)

(def SERVICE_HANDOFF_DH 8)

(def DATASTORE_MOVE_DH 16)

(constants engine
  (factor 0.8)
  (copy-minutes-per-gb 1))

(def SESSION_STATE_CRASHES 0.05)

(def PAYING_SHARE 0.05)

(def PLAN_PER_DAY 24)
