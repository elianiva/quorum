(def playtest-pace 2)

(def incident-gap-seconds 400)

(def live-tuning
  :type Tuning
  (:pace               playtest-pace
   :incidentGap        incident-gap-seconds
   :firstIncidentAfter first-incident-after-seconds
   :calendarPace       calendar-pace))

(def challenge-tuning
  :type Tuning
  (:pace               1
   :incidentGap        720
   :firstIncidentAfter 600
   :calendarPace       calendar-pace))

(def calendar-pace 24)

(def first-incident-after-seconds 90)
