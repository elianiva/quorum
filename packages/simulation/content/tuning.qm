(def playtest-pace 2)

(def incident-gap-seconds 400)

(def live-tuning
  :type Tuning
  (:pace               playtest-pace
   :incidentGap        incident-gap-seconds
   :firstIncidentAfter FIRST_INCIDENT_AFTER_SECONDS
   :calendarPace       CALENDAR_PACE))

(def challenge-tuning
  :type Tuning
  (:pace               1
   :incidentGap        720
   :firstIncidentAfter 600
   :calendarPace       CALENDAR_PACE))
