; TypeScript types shared by the content.
; qmc writes each name as a TypeScript alias in generated/types.ts and imports it where used.
(type LeverCaps
  (readonly (partial (record VentureId (readonly (object (kind LeverKindId) (step number)))))))

(type QueryCosts
  (readonly
    (object
      ("q-read" number)
      ("q-write" number)
      ("q-search" number)
      ("blob-put" number)
      ("q-tx" number)
      ("blob-get" number)
      ("q-scan" number))))

(type OutcomeBands (array (readonly (object (lo number) (hi number)))))

(type DeviceInfoById
  (record DeviceId (readonly (object (name string) (share number) (rttMs number)))))

(type AchievementDef (readonly (object (id AchievementId) (name string) (condition string))))

(type PricingDef (readonly (object (id PricingId) (name string) (price number) (blurb string))))

(type DeployStrategyDef
  (readonly
    (object (id DeployStrategyId) (name string) (deployMinutes number) (blast number) (burn number))))

(type RegionDef (readonly (object (name string) (short string) (share number) (offset number))))

(type IacToolDef
  (readonly
    (object
      (name string)
      (language string)
      (refreshOnPlan boolean)
      (refresh (union string null))
      (repair boolean))))

(type ExitDef
  (readonly
    (object
      (id ExitId)
      (name string)
      (stage number)
      (cap number)
      (multiplier number)
      (continues boolean))))

(type PerkDef (readonly (object (id PerkId) (name string) (costs (array number)) (effect string))))

(type PolicyDef
  (readonly
    (object
      (id PolicyId)
      (label string)
      (velocity number)
      (debt number)
      (badDeploy number)
      (deploysPerDay number)
      (paydown number))))

(type FamilyDef
  (readonly (object (id FamilyId) (name string) (ramPerVcpu number) (price number) (blurb string))))

(type LanguageDef
  (readonly
    (object
      (id LanguageId)
      (name string)
      (velocity number)
      (salary number)
      (hireTime number)
      (buildMinutes number)
      (sessionKB number)
      (armSpeed number)
      (armPortDh number)
      (blast (keys-of blast-factor)))))

(type ConcurrencyModel (literal "process" "threads" "loop" "green" "async"))

(type Axis (item-of axes))

(type Axes (readonly (record Axis (literal 1 2 3 4 5))))

(type RuntimeDef
  (readonly
    (object
      (id RuntimeId)
      (axes Axes)
      (glossary (array string))
      (language LanguageId)
      (name string)
      (model ConcurrencyModel)
      (speed number)
      (memoryMb number)
      (pool boolean)
      (threads number)
      (connections number)
      (persistent boolean)
      (startupSeconds number)
      (warmFrom number)
      (warmup number)
      (parallel boolean)
      (blocking (literal "loop" "worker" null))
      (gc (union (readonly (object (pauseMs number) (cpu number))) null))
      (connectionKB (union number null))
      (overheadFactor? number)
      (velocity? number)
      (hotReload? boolean)
      (build? number)
      (research (union ResearchId null))
      (blurb string))))

(type FrameworkDef
  (readonly
    (object
      (id FrameworkId)
      (axes Axes)
      (glossary (array string))
      (name string)
      (language (union LanguageId null))
      (overhead number)
      (cpu? (partial (record RequestKind number)))
      (asgi? boolean)
      (velocity number)
      (memoryMb number)
      (orm boolean)
      (value (partial (record RequestKind number)))
      (startupSeconds number)
      (workerOverhead? number)
      (coordination? number)
      (debt? number)
      (nativeBuild? number)
      (cacheable? number)
      (internalTools? number)
      (workerHours? number)
      (blurb string))))

(type VentureStart
  (readonly
    (object
      (cash number)
      (equity number)
      (stage number)
      (runtime (union RuntimeId null))
      (researched (array ResearchId)))))

(type SaleSchedule
  (readonly
    (object
      (everyDays number)
      (startMinute number)
      (minutes number)
      (kind RequestKind)
      (lift number))))

(type VentureConstraint
  (readonly
    (object
      (noNaiveRetries boolean)
      (residency (union number null))
      (deadline (union number null))
      (procurement boolean)
      (languages (union (array LanguageId) null))
      (sla (union number null))
      (gpus number)
      (hubsPerRegion (union number null))
      (egress number)
      (spikeWeight number)
      (staleFine number)
      (sale (union SaleSchedule null)))))

(type VentureShares (readonly (partial (record RequestKind number))))

(type VentureDef
  (readonly
    (object
      (id VentureId)
      (name string)
      (peak number)
      (amplitude number)
      (weekend number)
      (shares (union VentureShares null))
      (value number)
      (market number)
      (bootstrapped boolean)
      (start VentureStart)
      (constraint VentureConstraint)
      (signature (union IncidentId null))
      (legacy number)
      (summary string))))

(type MutatorDef (readonly (object (id MutatorId) (name string) (rule string) (legacy number))))

(type FeatureDef
  (readonly
    (object
      (id FeatureId)
      (name string)
      (era number)
      (dh number)
      (requires (array FeatureId))
      (research (union ResearchId null))
      (market number)
      (growth number)
      (churn number)
      (load (partial (record RequestKind number)))
      (value (partial (record RequestKind number)))
      (payload (partial (record RequestKind number)))
      (queries (partial (record BackendKind number)))
      (unlocks (union (readonly (object (kind RequestKind) (share number) (gated boolean))) null))
      (shapes number)
      (history number)
      (subscription boolean)
      (effect string)
      (hidden (union string null)))))

(type TaskDef
  (readonly
    (object
      (id TaskId)
      (name string)
      (dh number)
      (research (union ResearchId null))
      (effect string)
      (internal boolean))))

(type ResearchTeamKind (literal "product" "platform" "sre" "data" "security"))

(type LeverKind LeverKindId)

(type Kind (union RequestKind BackendKind))

(type KindInfo (readonly (object (label string) (value number) (color number))))

(type InsightPool (union RequestKind (literal "failure")))

(type RequestProfile
  (readonly
    (object
      (cpu number)
      (native boolean)
      (apdex number)
      (calls (readonly (partial (record (exclude BackendKind (literal "auth" "task")) number))))
      (asyncCalls
        (readonly
          (partial (record (literal "q-read" "q-write" "blob-put" "notify" "callout") number))))
      (orm boolean)
      (payloadKB number)
      (asyncKB number)
      (stream boolean)
      (compressible boolean)
      (inKB number)
      (offload number)
      (completion? number)
      (scored boolean))))

(type GlossaryCategory (item-of glossary-categories))

(type GlossaryEntry
  (readonly
    (object
      (id string)
      (term string)
      (category GlossaryCategory)
      (definition string)
      (inGame string)
      (design? (array (readonly (object (label string) (url string)))))
      (related (array string))
      (links (array (readonly (object (label string) (url string))))))))

(type Tuning
  (readonly
    (object (pace number) (incidentGap number) (firstIncidentAfter number) (calendarPace number))))

(type CveDef (readonly (object (id string) (score number) (affects (array ComponentId)))))
