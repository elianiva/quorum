(types "../catalog/ventures.ts" VentureStart VentureConstraint MutatorId MutatorDef)

(def GARAGE_START
  :type VentureStart
  (:cash       START_CASH
   :equity     1
   :stage      0
   :runtime    null
   :researched []))

(def MONEY_KINDS
  :type (array RequestKind)
  ["read" "write" "buy"])

(constants mutator
  (ids
    :type const
    ["chaos-monkey" "hn-front-page" "legacy-monolith" "one-region" "no-caches" "tight-budget"
     "single-language" "postgres" "strict-slo" "shared-tenancy"])
  (bans
    :type (partial (record MutatorId (array ComponentId)))
    (:no-caches ["cache" "cdn"]
     :postgres  ["cache" "wide" "dsql" "warehouse"])))

(table mutators
  :key      id
  :keep-key
  :type     (record MutatorId MutatorDef)
  [id                 name                       rule  legacy]
  ["chaos-monkey"     "Chaos Monkey"             "Instance failures dominate from Seed"  0.25]
  ["hn-front-page"    "Hacker News front page"   "Traffic spikes three times as often"  0.15]
  ["legacy-monolith"  "Legacy monolith"          "Large PHP codebase: migrations ×3, debt starts at 40%"  0.2]
  ["one-region"       "One region forever"       "No Nodes outside the home region"  0.2]
  ["no-caches"        "No caches"                "No Cache, no CDN"  0.4]
  ["tight-budget"     "Tight budget"             "Funding grants halved"  0.2]
  ["single-language"  "Single language"          "Every App Server runs PHP"  0.15]
  ["postgres"         "Postgres for everything"  "No Cache, wide-column, consensus or warehouse stores"  0.3]
  ["strict-slo"       "Strict SLO"               "The SLO is one level higher"  0.2]
  ["shared-tenancy"   "Shared tenancy"           "Noisy neighbours steal CPU from every instance"  0.1])

(constants monolith
  (kloc 40)
  (migration 3)
  (debt 0.4))

(constants steal
  (max 0.3)
  (seconds 30))

(def HN_WEIGHT 3)

(types "../catalog/ventures.ts" VentureDef VentureId)

(constants venture
  (ids
    :type const
    ["b2b-saas" "consumer-social" "fintech" "streaming" "game-backend" "ai-startup" "e-commerce"
     "developer-platform" "healthcare" "ad-tech" "bootstrapped" "government"])
  (defaults
    :satisfies (partial VentureDef)
    (:peak         20
     :amplitude    0.45
     :weekend      1
     :shares       null
     :value        1
     :market       1
     :bootstrapped false
     :start        GARAGE_START
     :constraint   NO_CONSTRAINT
     :signature    null)))

(def VENTURES
