(def garage-start
  :type VentureStart
  (:cash       start-cash
   :equity     1
   :stage      0
   :runtime    null
   :researched []))

(def money-kinds
  :type (array RequestKind)
  ["read" "write" "buy"])

(constants mutator
  (bans
    :type (partial (record MutatorId (array ComponentId)))
    (:no-caches ["cache" "cdn"]
     :postgres  ["cache" "wide" "dsql" "warehouse"])))

(table mutators
  :key      id
  :ids      mutator-ids
  :id-type  MutatorId
  :keep-key
  :type     (record MutatorId MutatorDef)
  [id               name                       rule  legacy]
  [chaos-monkey     "Chaos Monkey"             "Instance failures dominate from Seed"  0.25]
  [hn-front-page    "Hacker News front page"   "Traffic spikes three times as often"  0.15]
  [legacy-monolith  "Legacy monolith"          "Large PHP codebase: migrations ×3, debt starts at 40%"  0.2]
  [one-region       "One region forever"       "No Nodes outside the home region"  0.2]
  [no-caches        "No caches"                "No Cache, no CDN"  0.4]
  [tight-budget     "Tight budget"             "Funding grants halved"  0.2]
  [single-language  "Single language"          "Every App Server runs PHP"  0.15]
  [postgres         "Postgres for everything"  "No Cache, wide-column, consensus or warehouse stores"  0.3]
  [strict-slo       "Strict SLO"               "The SLO is one level higher"  0.2]
  [shared-tenancy   "Shared tenancy"           "Noisy neighbours steal CPU from every instance"  0.1])

(constants monolith
  (kloc 40)
  (migration 3)
  (debt 0.4))

(constants steal
  (max 0.3)
  (seconds 30))

(def hn-weight 3)

(constants venture
  (defaults
    :satisfies (partial VentureDef)
    (:peak         20
     :amplitude    0.45
     :weekend      1
     :shares       null
     :value        1
     :market       1
     :bootstrapped false
     :start        garage-start
     :constraint   no-constraint
     :signature    null)))

(records ventures
  :key      id
  :ids      venture-ids
  :id-type  VentureId
  :defaults venture-defaults
  :type     (record VentureId VentureDef)
  (b2b-saas
    :name       "B2B SaaS"
    :legacy     1
    :constraint (record (... no-constraint) :sla 4)
    :signature  "hot-shard"
    :summary    "Evening peak; the default mix")
  (consumer-social
    :name       "Consumer social"
    :weekend    1.15
    :shares     (mix
                  :page   8%
                  :read   13%
                  :write  5%
                  :login  5%
                  :search 3%
                  :upload 6%
                  :bot    5%
                  :media  14%
                  :rt     6%
                  :buy    2.5%
                  :job    2.5%
                  :report 2.5%
                  :ai     2.5%
                  :feed   18%
                  :hook   2.5%
                  :push   3.5%
                  :bid    1%)
    :value      0.55
    :market     2
    :legacy     1.1
    :signature  "hot-key"
    :constraint (record (... no-constraint) :spikeWeight 2)
    :summary    "Feeds and video dominate; twice the users at half the value")
  (fintech
    :name       "Fintech"
    :peak       14
    :amplitude  0.6
    :weekend    0.4
    :shares     (mix
                  :page   14%
                  :read   15.5%
                  :write  12%
                  :login  6%
                  :search 4%
                  :upload 3%
                  :bot    3%
                  :media  2.5%
                  :rt     2.5%
                  :buy    17%
                  :job    2.5%
                  :report 2.5%
                  :ai     2.5%
                  :feed   2.5%
                  :hook   7%
                  :push   2.5%
                  :bid    1%)
    :value      0.72
    :legacy     1.3
    :signature  "double-charge"
    :constraint (record (... no-constraint) :staleFine 20)
    :summary    "Business hours; checkouts and writes dominate; a stale money read is fined")
  (streaming
    :name       "Streaming media"
    :peak       21
    :amplitude  0.55
    :shares     (mix
                  :page   8%
                  :read   10%
                  :write  4%
                  :login  5%
                  :search 4%
                  :upload 3%
                  :bot    3%
                  :media  36%
                  :rt     3%
                  :buy    4%
                  :job    2.5%
                  :report 2.5%
                  :ai     2.5%
                  :feed   4%
                  :hook   2.5%
                  :push   5%
                  :bid    1%)
    :value      0.77
    :legacy     1.2
    :signature  "premiere-spike"
    :constraint (record (... no-constraint) :egress 3)
    :summary    "Late evening peak; video dominates; egress costs three times")
  (game-backend
    :name       "Game backend"
    :peak       21
    :shares     (mix
                  :page   8%
                  :read   10%
                  :write  8%
                  :login  8%
                  :search 3%
                  :upload 3%
                  :bot    3%
                  :media  4%
                  :rt     30.5%
                  :buy    4%
                  :job    2.5%
                  :report 2.5%
                  :ai     2.5%
                  :feed   2.5%
                  :hook   2.5%
                  :push   4%
                  :bid    2%)
    :value      0.83
    :legacy     1.3
    :constraint (record (... no-constraint) :hubsPerRegion 3)
    :signature  "launch-day"
    :summary    "Evening peak; realtime is most of the traffic")
  (ai-startup
    :name       "AI startup"
    :amplitude  0.1
    :shares     (mix
                  :page   10%
                  :read   11%
                  :write  5%
                  :login  4%
                  :search 6%
                  :upload 10%
                  :bot    3%
                  :media  3%
                  :rt     2.5%
                  :buy    3%
                  :job    6%
                  :report 4%
                  :ai     23%
                  :feed   2.5%
                  :hook   3%
                  :push   3%
                  :bid    1%)
    :value      0.74
    :legacy     1.3
    :constraint (record (... no-constraint) :gpus 2)
    :signature  "gpu-shortage"
    :summary    "Flat demand; prompts and uploads dominate; GPUs are scarce")
  (e-commerce
    :name       "E-commerce"
    :shares     (mix
                  :page   18%
                  :read   12%
                  :write  5%
                  :login  5%
                  :search 20%
                  :upload 2.5%
                  :bot    6%
                  :media  4%
                  :rt     2.5%
                  :buy    7%
                  :job    2.5%
                  :report 2.5%
                  :ai     2.5%
                  :feed   2.5%
                  :hook   4%
                  :push   3%
                  :bid    1%)
    :value      0.88
    :legacy     1.2
    :signature  "flash-sale"
    :constraint (record (... no-constraint)
                  :sale (:everyDays 30 :startMinute 720 :minutes 120 :kind "buy" :lift 20))
    :summary    "Pages and searches dominate; a scheduled monthly sale")
  (developer-platform
    :name       "Developer platform"
    :amplitude  0.1
    :shares     (mix
                  :page   13%
                  :read   22%
                  :write  6%
                  :login  6%
                  :search 3%
                  :upload 4%
                  :bot    4%
                  :media  2.5%
                  :rt     2.5%
                  :buy    3%
                  :job    3%
                  :report 2.5%
                  :ai     4%
                  :feed   2.5%
                  :hook   16%
                  :push   4%
                  :bid    2%)
    :value      0.83
    :market     1.5
    :legacy     1.35
    :constraint (record (... no-constraint) :noNaiveRetries true)
    :signature  "retry-storm"
    :summary    "Flat, bursty; API reads and webhooks dominate; no naive retries")
  (healthcare
    :name       "Healthcare"
    :peak       14
    :weekend    0.4
    :shares     (mix
                  :page   11%
                  :read   19%
                  :write  16.5%
                  :login  8%
                  :search 10%
                  :upload 4%
                  :bot    2%
                  :media  2.5%
                  :rt     2.5%
                  :buy    4%
                  :job    3%
                  :report 6%
                  :ai     3%
                  :feed   2.5%
                  :hook   2.5%
                  :push   2.5%
                  :bid    1%)
    :value      0.87
    :legacy     1.4
    :constraint (record (... no-constraint) :residency 3)
    :signature  "audit"
    :summary    "Business hours; writes and searches dominate; data stays in region")
  (ad-tech
    :name       "Ad tech"
    :amplitude  0.05
    :shares     (mix
                  :page   12%
                  :read   11%
                  :write  5%
                  :login  3%
                  :search 3%
                  :upload 2.5%
                  :bot    6%
                  :media  6%
                  :rt     2.5%
                  :buy    2.5%
                  :job    2.5%
                  :report 2.5%
                  :ai     4%
                  :feed   2.5%
                  :hook   2.5%
                  :push   2.5%
                  :bid    30%)
    :value      0.44
    :market     3
    :start      (record (... garage-start) :cash 400)
    :legacy     1.3
    :constraint (record (... no-constraint) :deadline 100)
    :signature  "latency-regression"
    :summary    "Flat and enormous; bids dominate; a request over 100 ms earns nothing")
  (government
    :name       "Government contract"
    :peak       14
    :weekend    0.2
    :shares     (mix
                  :page   19.5%
                  :read   15%
                  :write  12%
                  :login  8%
                  :search 6%
                  :upload 7%
                  :bot    2%
                  :media  2.5%
                  :rt     2.5%
                  :buy    5%
                  :job    3%
                  :report 5%
                  :ai     4%
                  :feed   2.5%
                  :hook   2.5%
                  :push   2.5%
                  :bid    1%)
    :value      1.51
    :market     0.8
    :start      (record (... garage-start) :cash 900 :runtime "tomcat" :researched ["lang-java"])
    :legacy     1.5
    :constraint (record (... no-constraint) :procurement true :languages ["java" "csharp"])
    :signature  "deadline-day"
    :summary    "Business hours; pages and records; Java or C#; a day to buy")
  (bootstrapped
    :name         "Bootstrapped indie"
    :bootstrapped true
    :legacy       1.4
    :summary      "No funding rounds; the default mix; Equity stays 100%"))

(def chaos-weight 4)

(def chaos-from-stage 2)

(def no-constraint
  :type VentureConstraint
  (:noNaiveRetries false
   :residency      null
   :deadline       null
   :procurement    false
   :languages      null
   :sla            null
   :gpus           0
   :hubsPerRegion  null
   :egress         1
   :spikeWeight    1
   :staleFine      0
   :sale           null))

(def slo-levels
  :type (array number)
  [0.99 0.995 0.999 0.9995 0.9999 0.99999])

(def start-cash 300)
