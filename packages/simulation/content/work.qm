(id FixId fixes)

(constants feature
  (defaults
    :satisfies (partial FeatureDef)
    (:requires     []
     :research     null
     :market       1
     :growth       1
     :churn        1
     :load         (record)
     :value        (record)
     :payload      (record)
     :queries      (record)
     :unlocks      null
     :shapes       0
     :history      1
     :subscription false
     :hidden       null)))

(def internal-tool-features
  :type (array FeatureId)
  ["dashboards" "audit-log" "status-page" "data-export"])

(def background-features
  :type (array FeatureId)
  ["email-digests" "data-export" "notifications-center" "webhooks" "push-notifications"])

(table tasks
  :key      id
  :ids      task-ids
  :id-type  TaskId
  :keep-key
  :type     (record TaskId TaskDef)
  [id                 name                          dh  research            effect  internal]
  [add-index          "Add index"                    4  "query-analysis"    "Ends a Slow query and covers one query shape"  false]
  [eager-loading      "Eager loading"               10  "eager-loading"     "ORM frameworks stop sending N+1 queries"  false]
  [fix-leak           "Fix memory leak"             15  null                "No leaks until the next Feature ships"  false]
  [session-state      "Drop session state"           8  "pooling"           "Transaction pooling stops breaking queries"  false]
  [refactor           "Refactor"                    10  null                "Tech debt −20 points"  false]
  [fix-bugs           "Fix migration bugs"           1  null                "The new Stack stops failing requests"  true]
  [upgrade-cluster    "Upgrade clusters"            24  "containers"        "Every Kubernetes Cluster runs a supported version for a quarter"  false]
  [runbook            "Write a runbook"             10  "runbooks"          "One incident kind resolves by itself, with no player action"  false]
  [idempotency-keys   "Idempotency keys"            20  "idempotency-keys"  "A retried checkout never charges twice"  false]
  [off-loop           "Move CPU work off the loop"  12  "worker-threads"    "Node.js and Python async send CPU-heavy kinds to worker threads"  false]
  [timeouts-retries   "Add timeouts and retries"     8  "timeouts"          "Every Link out of an App Server or Worker gets a 5 s timeout and backoff retries"  false]
  [graceful-shutdown  "Graceful shutdown"            6  null                "Deploys and scale-downs finish in-flight requests instead of failing them"  false]
  [health-check       "Health check endpoint"        4  "health-checks"     "A Load Balancer can run deep health checks"  false]
  [load-test          "Load test"                   15  null                "Shows every Node at twice the demand, for one calendar day"  false])

(def quarter-days 90)

(def fixes
  :type      const
  :satisfies (array TaskId)
  ["eager-loading" "fix-leak" "session-state" "idempotency-keys" "off-loop" "graceful-shutdown"
   "health-check"])

(records features
  :key      id
  :ids      feature-ids
  :id-type  FeatureId
  :defaults feature-defaults
  :type     (record FeatureId FeatureDef)
  (landing-page
    :name   "Landing page"
    :era    (era garage)
    :dh     8
    :market 1.2
    :load   (:page 1.1)
    :effect "Market +20%, page views +10%")
  (signup-flow
    :name    "Signup flow"
    :era     (era garage)
    :dh      16
    :growth  1.15
    :unlocks (:kind "write" :share 0.05 :gated false)
    :effect  "Growth +15%, writes arrive early")
  (pagination
    :name    "Pagination"
    :era     (era garage)
    :dh      4
    :payload (:read 0.5)
    :shapes  1
    :effect  "API reads send half the bytes"
    :hidden  "Adds a query shape with no index")
  (password-login
    :name     "Password login"
    :era      (era pre-seed)
    :dh       40
    :requires ["signup-flow"]
    :unlocks  (:kind "login" :share 0.05 :gated true)
    :effect   "Logins arrive: 80 ms of CPU each")
  (paid-plans
    :name         "Paid plans"
    :era          (era pre-seed)
    :dh           80
    :requires     ["password-login"]
    :value        (:write 1.3)
    :subscription true
    :effect       "Writes earn 30% more, plus subscriptions")
  (email-digests
    :name     "Email digests"
    :era      (era pre-seed)
    :dh       40
    :requires ["signup-flow"]
    :churn    0.9
    :unlocks  (:kind "job" :share 0.01 :gated false)
    :load     (:job 2)
    :effect   "Churn −10%. Digests send in a burst of jobs: twice the exports, 400 ms of CPU and 50 reads each"
    :hidden   "The send is a burst of jobs")
  (search-filters
    :name    "Search filters"
    :era     (era seed)
    :dh      40
    :value   (:search 1.25)
    :queries (:q-search 1.4)
    :effect  "Searches earn 25% more"
    :hidden  "Each search query costs 40% more")
  (profile-photos
    :name     "Profile photos"
    :era      (era seed)
    :dh       40
    :requires ["password-login"]
    :growth   1.1
    :unlocks  (:kind "upload" :share 0.04 :gated true)
    :effect   "Growth +10%, uploads arrive: 120 ms of CPU each")
  (public-api
    :name     "Public API"
    :era      (era seed)
    :dh       160
    :requires ["password-login"]
    :market   1.25
    :load     (:read 1.3 :bot 1.5)
    :effect   "Market +25%, API reads +30%"
    :hidden   "Bots +50%")
  (infinite-scroll
    :name     "Infinite scroll"
    :era      (era seed)
    :dh       24
    :requires ["pagination"]
    :value    (:read 1.1)
    :load     (:read 1.4)
    :effect   "API reads earn 10% more, and users send 40% more")
  (video
    :name     "Video"
    :era      (era series-a)
    :dh       480
    :requires ["profile-photos"]
    :market   1.4
    :unlocks  (:kind "media" :share 0.1 :gated true)
    :effect   "Market +40%, video arrives: 5 MB each")
  (chat
    :name     "Chat"
    :era      (era series-a)
    :dh       480
    :requires ["password-login"]
    :churn    0.8
    :research "websockets"
    :unlocks  (:kind "rt" :share 0.08 :gated true)
    :effect   "Churn −20%, realtime messages hold connections open")
  (checkout
    :name     "Checkout"
    :era      (era series-a)
    :dh       320
    :requires ["paid-plans"]
    :research "checkout"
    :unlocks  (:kind "buy" :share 0.03 :gated true)
    :effect   "Checkouts arrive: $25 each, through the Payment Provider")
  (notifications-center
    :name     "Notifications center"
    :era      (era series-a)
    :dh       80
    :requires ["chat"]
    :growth   1.1
    :load     (:rt 1.2)
    :effect   "Growth +10%, realtime +20%")
  (mobile-app
    :name     "Mobile app"
    :era      (era series-a)
    :dh       960
    :requires ["public-api"]
    :market   1.6
    :load     (:read 1.5)
    :effect   "Market +60%, API reads +50%")
  (data-export
    :name    "Data export"
    :era     (era series-b)
    :dh      80
    :value   (:write 1.2)
    :unlocks (:kind "job" :share 0.02 :gated true)
    :effect  "Writes earn 20% more. Exports arrive: 400 ms of CPU and 50 reads each")
  (dashboards
    :name    "Dashboards"
    :era     (era series-b)
    :dh      480
    :market  1.1
    :history 0.5
    :unlocks (:kind "report" :share 0.03 :gated true)
    :effect  "Market +10%. Reports arrive: a table scan each")
  (ai-assistant
    :name     "AI assistant"
    :era      (era series-b)
    :dh       480
    :research "hosted-models"
    :unlocks  (:kind "ai" :share 0.05 :gated true)
    :effect   "AI prompts arrive: $24 each, served by a GPU Node or the LLM API")
  (recommendations
    :name     "Recommendations"
    :era      (era series-b)
    :dh       480
    :requires ["video" "data-export"]
    :history  0.5
    :load     (:media 1.3 :job 1.3)
    :effect   "Video +30%"
    :hidden   "Exports +30%: the model trains in batch")
  (audit-log
    :name     "Audit log"
    :era      (era series-b)
    :dh       120
    :requires ["password-login"]
    :market   1.1
    :queries  (:q-write 1.2)
    :effect   "Market +10%: enterprises can buy"
    :hidden   "Each write query costs 20% more")
  (activity-feed
    :name     "Activity feed"
    :era      (era series-c)
    :dh       480
    :market   1.5
    :research "hybrid-fanout"
    :unlocks  (:kind "feed" :share 0.08 :gated true)
    :effect   "Market +50%. Feeds arrive: 20 reads each, or one timeline with fan-out on write")
  (webhooks
    :name     "Webhooks"
    :era      (era series-c)
    :dh       120
    :requires ["public-api"]
    :market   1.2
    :unlocks  (:kind "hook" :share 0.02 :gated true)
    :effect   "Market +20%. Webhooks arrive: 800 ms calls to customer servers")
  (push-notifications
    :name     "Push notifications"
    :era      (era series-c)
    :dh       80
    :requires ["mobile-app" "notifications-center"]
    :growth   1.15
    :churn    1.05
    :research "notifications"
    :unlocks  (:kind "push" :share 0.02 :gated true)
    :effect   "Growth +15%. Notifications arrive, through the Push Provider"
    :hidden   "Churn +5%: users tire of them")
  (localization
    :name   "Localization"
    :era    (era series-c)
    :dh     480
    :market 1.24
    :effect "Market +40% outside North America")
  (offline-mode
    :name     "Offline mode"
    :era      (era series-c)
    :dh       480
    :requires ["mobile-app"]
    :churn    0.9
    :load     (:write 1.1)
    :effect   "Churn −10%"
    :hidden   "Writes +10%: devices sync in bursts on reconnect")
  (single-sign-on
    :name     "Single sign-on"
    :era      (era pre-ipo)
    :dh       240
    :requires ["password-login"]
    :market   1.1
    :effect   "Market +10%: enterprises sign in with SAML")
  (data-residency
    :name   "Data residency"
    :era    (era pre-ipo)
    :dh     1_440
    :effect "Required for the EU market: EU data stays in an EU region")
  (status-page
    :name   "Status page"
    :era    (era pre-ipo)
    :dh     16
    :churn  0.9
    :effect "Churn −10%: users see you are on it")
  (usage-pricing
    :name     "Usage-based pricing"
    :era      (era public)
    :dh       480
    :requires ["paid-plans"]
    :value    (:job 1.15 :write 1.15 :ai 1.15 :hook 1.15)
    :effect   "Exports, writes, prompts and webhooks earn 15% more"))
