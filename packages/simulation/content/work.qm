                        :churn 1.05
                        :research "notifications"
                        :unlocks (:kind "push" :share 0.02 :gated true)
                        :effect "Growth +15%. Notifications arrive, through the Push Provider"
                        :hidden "Churn +5%: users tire of them")
   :localization (record
                  (... FEATURE_DEFAULTS)
                  :id "localization"
                  :name "Localization"
                  :era 5
                  :dh 480
                  :market 1.24
                  :effect "Market +40% outside North America")
   :offline-mode (record
                  (... FEATURE_DEFAULTS)
                  :id "offline-mode"
                  :name "Offline mode"
                  :era 5
                  :dh 480
                  :requires ["mobile-app"]
                  :churn 0.9
                  :load (:write 1.1)
