(types "../catalog/work.ts" FeatureId TaskId TaskDef)

(def FEATURE_IDS :type const
  ["landing-page"
   "signup-flow"
   "pagination"
   "password-login"
   "paid-plans"
   "email-digests"
   "search-filters"
   "profile-photos"
