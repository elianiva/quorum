   :status-page (record
                 (... FEATURE_DEFAULTS)
                 :id "status-page"
                 :name "Status page"
                 :era 6
                 :dh 16
                 :churn 0.9
                 :effect "Churn −10%: users see you are on it")
   :usage-pricing (record
                   (... FEATURE_DEFAULTS)
                   :id "usage-pricing"
                   :name "Usage-based pricing"
                   :era 7
                   :dh 480
                   :requires ["paid-plans"]
                   :value (:job 1.15 :write 1.15 :ai 1.15 :hook 1.15)
                   :effect "Exports, writes, prompts and webhooks earn 15% more")))
