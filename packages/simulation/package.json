{
  "name": "@quorum/simulation",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./kernel.wasm": "./src/kernel.wasm",
    "./host/node": "./host/node.ts",
    "./host/browser": "./host/browser.ts",
    "./host/worker": "./host/worker.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsrs --noEmit -p tsconfig.json && tsrs --noEmit -p tsconfig.hosts.json && effect-tsrs diagnostics --strict --project tsconfig.json",
    "test": "vitest run",
    "test:full": "FULL_TESTS=1 vitest run",
    "test:engines": "vitest run --config vitest.engines.config.ts && node engines/workerd.mjs"
  },
  "dependencies": {
    "@typeonce/effect-machine": "0.46.0",
    "effect": "4.1.2"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "5.1.0",
    "esbuild": "0.28.2",
    "playwright": "1.65.0",
    "vitest": "5.1.0",
    "workerd": "1.20261106.1"
  }
}
