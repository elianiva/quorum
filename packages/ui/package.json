{
  "name": "@quorum/ui",
  "private": true,
  "type": "module",
  "exports": {
    "./primitives/*": "./src/primitives/*.ts",
    "./game/*": "./src/game/*.ts",
    "./board/*": "./src/board/*.ts",
    "./i18n/*": "./src/i18n/*.ts",
    "./theme.css": "./src/theme.css"
  },
  "scripts": {
    "typecheck": "tsrs --noEmit -p tsconfig.json && effect-tsrs diagnostics --strict --project tsconfig.json",
    "test": "vitest run",
    "stress": "node src/board/stress.perf.ts"
  },
  "dependencies": {
    "@chenglou/pretext": "^1.0.0",
    "@foldkit/ui": "0.170.0",
    "@quorum/simulation": "workspace:*",
    "cn": "0.5.2",
    "d3-shape": "^3.2.1",
    "effect": "4.1.2",
    "foldkit": "0.170.0",
    "lucide": "1.70.0",
    "pixi.js": "8.22.0",
    "simple-icons": "16.36.0"
  },
  "devDependencies": {
    "@types/d3-shape": "^3.2.0",
    "@types/node": "26.6.6",
    "vitest": "5.1.0"
  }
}
