{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "content": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/qmc/src/**",
        "$TURBO_ROOT$/packages/qmc/Cargo.*",
        "$TURBO_ROOT$/packages/qmc/rust-toolchain.toml"
      ],
      "outputs": ["src/generated/**", "src/solver.wasm", "solver/src/catalog.rs"]
    },
    "build": {
      "dependsOn": ["^build", "^content", "content"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "^content", "content"]
    },
    "test": {
      "dependsOn": ["transit", "^content", "content"],
      "env": ["SLOW_TESTS", "FULL_TESTS"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
